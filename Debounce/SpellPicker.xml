<Ui xmlns="http://www.blizzard.com/wow/ui/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/FrameXML/UI.xsd">

	<Script file="SpellPicker.lua" />

	<!--
		주문 한 줄. 아이콘 + 이름 + 부제가 전부다.

		블리자드의 `SpellBookItemTemplate`을 안 쓴 이유가 여기 있다 - 그 믹스인은 picker가
		아니라 **caster**다(OnIconClick -> CastSpellBookItem). OnShow마다 이벤트를 다섯 개
		걸고 EventRegistry 공용 콜백에 우리가 끼어들게 된다. 행 하나가 이만한 물건이면
		자체 템플릿이 훨씬 싸다.

		아트는 왼쪽 목록(DebounceLineTemplate)과 같은 아틀라스를 쓴다 - 같은 애드온의 두
		목록이 다른 물건처럼 보이면 안 된다. `useAtlasSize`는 안 준다. 저 아틀라스는 450px
		짜리라 크기를 따라가면 두 컬럼에 안 들어간다.
	-->
	<Button name="DebounceSpellPickerRowTemplate" mixin="DebounceSpellPickerRowMixin" virtual="true">
		<Size x="240" y="38"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" atlas="ClickCastList-ButtonBackground" setAllPoints="true"/>
				<Texture file="Interface\Buttons\UI-EmptySlot-Disabled">
					<Size x="32" y="32"/>
					<Anchors>
						<Anchor point="LEFT" x="1" y="0"/>
					</Anchors>
					<TexCoords left="0.140625" right="0.84375" top="0.140625" bottom="0.84375"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Size x="28" y="28"/>
					<Anchors>
						<Anchor point="LEFT" x="3" y="0"/>
					</Anchors>
				</Texture>
				<FontString parentKey="Name" inherits="GameFontNormalSmall" maxLines="1" justifyH="LEFT">
					<Size x="195" y="0"/>
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="5" y="6"/>
					</Anchors>
				</FontString>
				<!--
					부제 자리는 하나다. 랭크(subName)와 비활성 특성 이름이 같은 자리를 쓴다 -
					둘을 나란히 두면 240px 안에서 둘 다 잘린다. 어느 쪽이 이기는지는 Init에 있다.
				-->
				<FontString parentKey="SubName" inherits="GameFontDisableSmall" maxLines="1" justifyH="LEFT">
					<Size x="195" y="0"/>
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Name" relativePoint="LEFT" x="0" y="-13"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="FrameHighlight" atlas="ClickCastList-ButtonHighlight" setAllPoints="true" alphaMode="ADD">
					<Color r="1" g="1" b="0" a="1"/>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnClick method="OnClick"/>
		</Scripts>
	</Button>

	<!--
		목록의 머리글(일반 / 직업 / 특성 / 즐겨찾기 …).

		**격자는 이 프레임을 반 칸으로 안다.** `AnchorUtil.GridLayout`은 stride를 고정으로
		두고 `frames[1]`에서 셀 크기를 한 번 가져다 전부 같은 크기로 놓는다 - 한 줄을 통째로
		차지하게 만드는 스위치가 없다. 그래서 크기는 행과 **똑같아야** 한다(240×38).
		안 그러면 이 아래 전부가 어긋난다.

		머리글이 오른쪽 칸에 서는 일은 없다. 데이터를 만들 때 앞뒤로 빈 칸을 채워
		언제나 줄 첫 칸에 오게 한다(SpellPicker.lua의 BuildDisplayList).

		글자와 구분선은 자기 칸 밖으로 나간다. 프레임 경계는 그리기를 자르지 않으므로
		(스크롤 자식이 아니다) 오른쪽 칸까지 뻗어서 폭 484짜리 머리글처럼 보인다.
		아트는 상세 패널의 구역 제목(DebounceSectionHeaderTemplate)과 같은 것을 쓴다.
	-->
	<Frame name="DebounceSpellPickerHeaderTemplate" mixin="DebounceSpellPickerHeaderMixin" virtual="true">
		<Size x="240" y="38"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontNormalSmall" justifyH="LEFT" maxLines="1">
					<Anchors>
						<Anchor point="LEFT" x="4" y="0"/>
					</Anchors>
				</FontString>
				<!-- x="244"가 옆 칸을 건너뛰는 값이다: 행 240 + 가로 간격 4. -->
				<Texture parentKey="Divider" atlas="Options_HorizontalDivider">
					<Size y="1"/>
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Label" relativePoint="RIGHT" x="8" y="0"/>
						<Anchor point="RIGHT" x="244" y="0"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<!--
		머리글 옆(과 앞)을 메우는 빈 칸. 격자에 "건너뛰기"가 없어서 자리를 실제로 차지하는
		프레임이 하나 있어야 한다. 아무것도 안 그리고 마우스도 안 받는다.
	-->
	<Frame name="DebounceSpellPickerSpacerTemplate" virtual="true">
		<Size x="240" y="38"/>
	</Frame>

	<!--
		카테고리 탭. 메인 창의 레이어 탭(DebounceFrameTabTemplate)과 같은 물건이다 -
		`PanelTabButtonTemplate`을 창 **아래쪽 바깥**에 매단다.

		처음에는 상세 패널이 쓰는 위쪽 탭(TabSystemTopButtonTemplate)으로 짰는데, 그 아트는
		패널 제목을 겸하는 크기라 창에 얹으니 머리가 너무 컸고 가운데 정렬된 제목과도 자리를
		다퉜다. 블리자드도 같은 성격의 창 - 수집품(탈것/애완동물/장난감) - 을 아래쪽 탭으로
		단다. 우리 메인 창과 같은 선에 서는 것은 덤이다.
	-->
	<Button name="DebounceSpellPickerTabTemplate" mixin="DebounceSpellPickerTabMixin" virtual="true" inherits="PanelTabButtonTemplate">
		<Scripts>
			<OnClick method="OnClick"/>
		</Scripts>
	</Button>

	<!--
		독립창이다. `parent="UIParent"` - 메인 창의 자식으로 두면 메인 창을 옮길 때 딸려간다
		(`DebounceIconSelectorFrame`이 그렇다). 자리도 따로 저장한다.

		그래도 **수명은 메인 창에 묶여 있다.** `DebounceFrameMixin:OnHide`가 같이 닫는다 -
		X 버튼도, ESC도, 전투 진입도 전부 그 경로로 온다. 반대 방향은 없다: 이 창을 닫아도
		메인 창은 남는다.

		키보드를 켜지 않는다. 검색창(EditBox)만 포커스를 갖고 거기서 ESC는 포커스만 푼다.
		그러면 이 창이 전파 상태(SetPropagateKeyboardInput)를 손댈 일 자체가 없어진다 -
		전투 중에는 그게 taint라 부를 수도 없다. 창을 닫는 ESC는 메인 창의 ESC 사다리가
		처리한다(`DebounceFrameMixin:HandleEscape`).
	-->
	<Frame name="DebounceSpellPickerFrame" inherits="PortraitFrameTemplate" parent="UIParent" toplevel="true"
		frameStrata="MEDIUM" enableMouse="true" hidden="true" mixin="DebounceSpellPickerFrameMixin"
		movable="true" clampedToScreen="true">
		<Size x="524" y="540"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Frames>
			<!--
				메인 창의 레이어 탭과 같은 자리다(DebounceUI.xml의 Tab1/Tab2).
				두 창을 나란히 놓고 쓰는 물건이라 탭이 다른 높이에 서면 눈에 바로 걸린다.

				**2번 탭부터의 오프셋은 여기 적어도 화면에 닿지 않는다.**
				`PanelTemplates_SetNumTabs`가 내부에서 `PanelTemplates_AnchorTabs`를 부르고,
				그게 2번 탭부터 TOPLEFT→TOPRIGHT +3으로 앵커를 통째로 덮어쓴다. 그래도 같은
				값을 적어두는 것은 이 파일만 읽는 사람이 실제와 다른 간격을 믿지 않게 하려는
				것이다 - 블리자드 창들에 남은 -15/-16이 딱 그 함정이고, 한때 우리 피커가
				그걸 베껴 와서 캡이 포개져 있었다(SpellPicker.lua RefreshList 참고).

				탭 개수는 카탈로그의 카테고리 수와 같다. 소스를 하나 더 붙이는 날 여기에도
				한 줄이 는다 - `PanelTabButtonTemplate`이 parentArray="Tabs"를 들고 있어서
				`self.Tabs`는 저절로 차고, Lua 쪽은 개수를 세기만 한다.
			-->
			<Button parentKey="Tab1" inherits="DebounceSpellPickerTabTemplate" id="1">
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="12" y="1"/>
				</Anchors>
			</Button>
			<Button parentKey="Tab2" inherits="DebounceSpellPickerTabTemplate" id="2">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Tab1" relativePoint="TOPRIGHT" x="3" y="0"/>
				</Anchors>
			</Button>
			<Button parentKey="Tab3" inherits="DebounceSpellPickerTabTemplate" id="3">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Tab2" relativePoint="TOPRIGHT" x="3" y="0"/>
				</Anchors>
			</Button>
			<Button parentKey="Tab4" inherits="DebounceSpellPickerTabTemplate" id="4">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Tab3" relativePoint="TOPRIGHT" x="3" y="0"/>
				</Anchors>
			</Button>
			<Button parentKey="Tab5" inherits="DebounceSpellPickerTabTemplate" id="5">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Tab4" relativePoint="TOPRIGHT" x="3" y="0"/>
				</Anchors>
			</Button>
			<Button parentKey="Tab6" inherits="DebounceSpellPickerTabTemplate" id="6">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Tab5" relativePoint="TOPRIGHT" x="3" y="0"/>
				</Anchors>
			</Button>

			<Frame parentKey="ScrollBoxBackground" useParentLevel="true" inherits="InsetFrameTemplate">
				<Size x="500" y="0"/>
				<Anchors>
					<!--
						-84는 메인 창의 좌측 인셋(-85)과 같은 선이다. 더 올릴 수는 없다 -
						초상화가 62px짜리라 y=-55까지 내려오고, 검색창은 이 인셋 바로 위에
						선다(그래서 -58에서 시작한다).
					-->
					<Anchor point="TOPLEFT" x="4" y="-84"/>
					<Anchor point="BOTTOMLEFT" x="4" y="10"/>
				</Anchors>
			</Frame>

			<Button parentKey="ScrollBox" inherits="WowScrollBoxList" frameLevel="3">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPLEFT" x="5" y="-5"/>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollBoxBackground" relativePoint="BOTTOMRIGHT" x="-5" y="5"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="EmptyText" hidden="true" inherits="GameFontDisable" justifyH="CENTER">
							<Size x="360" y="0"/>
							<Anchors>
								<Anchor point="TOP" x="0" y="-40"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Button>
			<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPRIGHT" x="5" y="-5"/>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="BOTTOMRIGHT" x="5" y="5"/>
				</Anchors>
			</EventFrame>

			<!--
				머리 줄은 **[만들기] … [검색][필터]** 다.

				검색과 필터가 오른쪽에 붙어 한 쌍이고 왼쪽은 그 창이 필요한 것을 놓는 자리 -
				블리자드의 수집품 창들이 그렇게 서 있다(애완동물 창은 총 마릿수, 장난감
				상자는 수집 진행 막대). 우리는 그 자리를 [새 매크로]에 쓴다.

				**이 셋은 XML 순서가 앵커 순서다.** 필터가 검색보다 먼저 선언돼야 하고
				(검색이 필터에 매달린다) 그래서 읽는 순서와 선언 순서가 뒤집혀 있다.
			-->
			<DropdownButton parentKey="FilterDropdown" inherits="WowStyle1FilterDropdownTemplate">
				<Size x="110" y="22"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPRIGHT" x="-2" y="4"/>
				</Anchors>
			</DropdownButton>

			<!--
				검색은 **실제로 걸러낸다.** 메인 창처럼 "안 맞는 줄을 흐리게" 할 수가 없다 -
				여기는 수백 개다.

				폭 170은 블리자드 수집품 창들의 검색창과 같은 선이다. 한때 220이었는데,
				그때는 이 줄에 검색과 필터 둘뿐이라 넓어도 남는 자리가 없었다.
			-->
			<EditBox parentKey="SearchBox" inherits="SearchBoxTemplate" letters="40">
				<Size x="170" y="22"/>
				<Anchors>
					<Anchor point="RIGHT" relativeKey="$parent.FilterDropdown" relativePoint="LEFT" x="-6" y="0"/>
				</Anchors>
			</EditBox>

			<!--
				이 줄에서 **유일하게 만드는 물건**이다. 목록은 이미 가진 것에서 고르는
				자리이고 매크로 텍스트만은 여기서 새로 태어난다 - 주문서에도 없고 커서로
				끌어올 수도 없어서(`GetActionTypeAndValueFromCursorInfo`가 받는 건
				주문·매크로·아이템·탈것 넷뿐이다) 이 버튼이 유일한 길이다.

				**목록 행이 아니라 크롬에 둔다.** 행으로 두면 "고르면 추가된다"는 목록의
				계약에 예외가 하나 생긴다.

				폭은 `OnLoad`에서 글자에 맞춘다 - 번역이 길어져도 잘리지 않게.
			-->
			<Button parentKey="NewMacroButton" inherits="UIPanelButtonTemplate">
				<Size x="120" y="22"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPLEFT" x="6" y="4"/>
				</Anchors>
			</Button>
		</Frames>
		<Scripts>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEvent method="OnEvent"/>
		</Scripts>
	</Frame>

</Ui>
