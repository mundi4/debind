<Ui xmlns="http://www.blizzard.com/wow/ui/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/FrameXML/UI.xsd">

	<Script file="DebounceUI.lua" />
	<Script file="DropDownMenus.lua" />

	<!--
		상세 패널 안의 구역 제목. 제목 하나에 인셋을 또 두르면 상자 안의 상자가 되므로
		선 하나로 나눈다. 아틀라스는 블리자드 옵션 패널이 같은 용도로 쓰는 것이다.

		선이 **글자 뒤에서 시작한다.** 제목 위에 선을 얹거나 글자를 가운데 두면 구역이
		둘로 보이는데, 여기서 나누려는 건 위아래지 좌우가 아니다.
	-->
	<Frame name="DebounceSectionHeaderTemplate" virtual="true">
		<Size y="16"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontNormalSmall" justifyH="LEFT" maxLines="1">
					<Anchors>
						<Anchor point="LEFT" x="2" y="0"/>
					</Anchors>
				</FontString>
				<Texture parentKey="Divider" atlas="Options_HorizontalDivider">
					<Size y="1"/>
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Label" relativePoint="RIGHT" x="8" y="0"/>
						<Anchor point="RIGHT" x="-2" y="0"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="DebounceGlowBorderTemplate" virtual="true">
		<Size x="100" y="100"/>
		<Layers>
			<Layer level="BORDER">
				<Texture parentKey="TopLeft" parentArray="Textures" file="Interface\Common\GlowBorder-Corner" alphaMode="ADD">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="-8" y="8"/>
					</Anchors>
				</Texture>
				<Texture parentKey="TopRight" parentArray="Textures" file="Interface\Common\GlowBorder-Corner" alphaMode="ADD">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="TOPRIGHT" x="8" y="8"/>
					</Anchors>
					<TexCoords left="1" right="0" top="0" bottom="1"/>
				</Texture>
				<Texture parentKey="BottomLeft" parentArray="Textures" file="Interface\Common\GlowBorder-Corner" alphaMode="ADD">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="-8" y="-8"/>
					</Anchors>
					<TexCoords left="0" right="1" top="1" bottom="0"/>
				</Texture>
				<Texture parentKey="BottomRight" parentArray="Textures" file="Interface\Common\GlowBorder-Corner" alphaMode="ADD">
					<Size x="16" y="16"/>
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="8" y="-8"/>
					</Anchors>
					<TexCoords left="1" right="0" top="1" bottom="0"/>
				</Texture>

				<Texture parentKey="Top" parentArray="Textures" file="Interface\Common\GlowBorder-Top" alphaMode="ADD">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.TopLeft" relativePoint="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.TopRight" relativePoint="BOTTOMLEFT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="Bottom" parentArray="Textures" file="Interface\Common\GlowBorder-Top" alphaMode="ADD">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.BottomLeft" relativePoint="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomRight" relativePoint="BOTTOMLEFT"/>
					</Anchors>
					<TexCoords left="0" right="1" top="1" bottom="0"/>
				</Texture>

				<Texture parentKey="Left" parentArray="Textures" file="Interface\Common\GlowBorder-Left" alphaMode="ADD">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.TopLeft" relativePoint="BOTTOMLEFT"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomLeft" relativePoint="TOPRIGHT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="Right" parentArray="Textures" file="Interface\Common\GlowBorder-Left" alphaMode="ADD">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.TopRight" relativePoint="BOTTOMLEFT"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.BottomRight" relativePoint="TOPRIGHT"/>
					</Anchors>
					<TexCoords left="1" right="0" top="0" bottom="1"/>
				</Texture>
			</Layer>
		</Layers>
	</Frame>
	
	<!--
		단축키 정렬에서 키가 바뀌는 자리마다 들어가는 줄.

		**마우스를 켜지 않는다.** 이 창은 드래그를 어디에 떨궈도 받는다 - 위치가 뜻을
		가지지 않기 때문이다. 헤더가 마우스를 먹으면 그 띠만 드롭이 죽는 사각지대가
		되므로, 이벤트를 밑의 ScrollBox로 그냥 통과시킨다. 그래서 Button이 아니라 Frame이다.
	-->
	<Frame name="DebounceKeyHeaderTemplate" mixin="DebounceKeyHeaderMixin" virtual="true">
		<Size x="450" y="20"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Label" inherits="GameFontNormalSmall" justifyH="LEFT" maxLines="1">
					<Anchors>
						<Anchor point="LEFT" x="4" y="0"/>
					</Anchors>
				</FontString>
				<!--
					글자 뒤부터 오른쪽 끝까지 긋는다. 라벨이 세로 가운데에 걸려 있어야
					두 앵커의 높이가 어긋나지 않는다.
				-->
				<Texture parentKey="Divider">
					<Size y="1"/>
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Label" relativePoint="RIGHT" x="6" y="0"/>
						<Anchor point="RIGHT" x="-2" y="0"/>
					</Anchors>
					<Color r="1" g="1" b="1" a="0.15"/>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<Button name="DebounceLineTemplate" mixin="DebounceLineMixin" virtual="true">
		<Size x="450" y="46"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="TopBorder" parentArray="Textures" hidden="true">
					<Size y="2.0" />
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT" x="-4" y="2"/>
						<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT" x="4" y="2"/>
					</Anchors>
					<Color r="1" g="1" b="1" a="1"/>
				</Texture>
				<Texture parentKey="BottomBorder" parentArray="Textures" hidden="true">
					<Size y="2.0" />
					<Anchors>
						<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="-4" y="-2"/>
						<Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT" x="4" y="-2"/>
					</Anchors>
					<Color r="1" g="1" b="1" a="1"/>
				</Texture>
				<Texture parentKey="Background" atlas="ClickCastList-ButtonBackground" useAtlasSize="true">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
				<Texture file="Interface\Buttons\UI-EmptySlot-Disabled">
					<Size x="39" y="39"/>
					<Anchors>
						<Anchor point="LEFT" relativePoint="LEFT" x="-2" y="0"/>
					</Anchors>
					<TexCoords left="0.140625" right="0.84375" top="0.140625" bottom="0.84375"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Size x="35" y="35"/>
					<Anchors>
						<Anchor point="LEFT" relativePoint="LEFT" x="0" y="0"/>
					</Anchors>
				</Texture>
				<!--
					이름 앞의 두 칸이 "이 액션이 어디 사는가"를 말한다. **오버뷰 탭에서만
					켜진다** - 레이어 탭에서는 목록 전체가 한 레이어라 모든 행에 같은 그림이
					붙고, 그러면 아무것도 구별하지 못하면서 이름만 밀어낸다. 그 답은 창
					제목에 이미 있다.

					규칙은 순서 리스트(DebounceOrderLineTemplate)와 **글자 그대로 같다** -
					아이콘 하나 = 좁혀진 축 하나, 빈 칸은 남기지 않음, 이름 앵커는 Update가
					다시 잡음. 한 창 안에서 레이어가 섞이는 목록이 둘인데 서로 다른 그림
					규칙을 쓰면 배울 것이 두 벌이 된다. 왜 그 규칙인지는 저쪽 주석에 있다.
				-->
				<Texture parentArray="LayerIcons" parentKey="LayerIcon1" hidden="true">
					<Size x="14" y="14"/>
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="5" y="7"/>
					</Anchors>
				</Texture>
				<Texture parentArray="LayerIcons" parentKey="LayerIcon2" hidden="true">
					<Size x="14" y="14"/>
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.LayerIcon1" relativePoint="RIGHT" x="3" y="0"/>
					</Anchors>
				</Texture>
				<FontString parentKey="Name" inherits="GameFontNormal" maxLines="1" justifyH="LEFT">
					<Size x="430" y="0"/>
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="5" y="7"/>
					</Anchors>
				</FontString>
				<FontString parentKey="InfoText" inherits="GameFontNormalSmall" justifyH="RIGHT">
					<Size x="430" y="0"/>
					<Anchors>
						<Anchor point="TOPRIGHT" relativePoint="TOPRIGHT" x="-5" y="-9"/>
					</Anchors>
					<Color color="NORMAL_FONT_COLOR"/>
				</FontString>
				<!--
					**이름이 아니라 아이콘에 매달린다.** 값은 예전과 같다(이름의 왼쪽 앵커를
					그대로 따라간 자리다). 이름은 레이어 아이콘 때문에 행마다 다른 x에서
					시작할 수 있는데, 단축키까지 같이 밀리면 이 목록의 조직 축인 키 칸이
					행마다 들쭉날쭉해진다.
				-->
				<FontString parentKey="BindingText" inherits="GameFontHighlightSmall" maxLines="1" justifyH="LEFT">
					<Size x="430" y="0"/>
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="5" y="-8"/>
					</Anchors>
				</FontString>
				<!--
					단축키에 문제가 있다는 표시. "?"(QuestionMark)는 **조건이 붙어 있다**는
					뜻이라 자리를 뺏으면 안 된다 - 조건부이면서 단축키가 문제인 액션이 흔하다.
					가로 위치는 단축키 글자 길이에 따라 달라지므로 Lua에서 잡는다.
				-->
				<Texture parentKey="KeyWarning" atlas="transmog-icon-warning-small" hidden="true">
					<Size x="14" y="14"/>
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.BindingText" relativePoint="LEFT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="QuestionMark" atlas="questlog-questtypeicon-quest" hidden="false">
					<Size x="14" y="14"/>
					<Anchors>
						<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-2" y="7"/>
					</Anchors>
				</Texture>
				<FontString parentKey="InfoText2" inherits="GameFontNormalSmall" justifyH="RIGHT">
					<Size x="430" y="0"/>
					<Anchors>
						<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-5" y="9"/>
					</Anchors>
					<Color r="1" g="1" b="1" a="1"/>
				</FontString>
				<FontString parentKey="SpecialConditionsText" inherits="GameFontNormalSmall" maxLines="1" justifyH="RIGHT" text="">
					<Size x="430" y="0"/>
					<Anchors>
						<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT" x="-5" y="9"/>
					</Anchors>
					<Color r="1" g="1" b="1" a="1"/>
				</FontString>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="SelectedHighlight" atlas="auctionhouse-ui-row-select" alpha=".8" hidden="true" alphaMode="ADD"/>
				<!--
					우클릭 메뉴가 열린 행. 선택 강조(SelectedHighlight)와 색으로 나눌 수가
					없다 - SetVertexColor는 곱셈이라 노란 아틀라스에서 갈 수 있는 곳이
					주황~빨강뿐이고, 그건 오류로 읽힌다. 그래서 색이 아니라 모양으로 나눈다:
					선택은 채우는 막대, 메뉴 대상은 두르는 테두리. 한 행이 둘 다여도 둘 다
					보인다.

					FrameHighlight와 같은 아트지만 그건 HIGHLIGHT 레이어라 마우스가 올라가
					있을 때만 나온다. 메뉴가 떠 있는 동안 마우스는 행 위에 없다.
				-->
				<Texture parentKey="MenuHighlight" atlas="ClickCastList-ButtonHighlight" useAtlasSize="true" hidden="true" alphaMode="ADD">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<Color r="1" g="1" b="0" a="1"/>
				</Texture>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="FrameHighlight" atlas="ClickCastList-ButtonHighlight" useAtlasSize="true" alphaMode="ADD">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
					<Color r="1" g="1" b="0" a="1"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<!--
				단축키 칸. 평소에는 `BindingText`가 글자로만 서 있고, 마우스가 이 행에 올라오면
				그 자리에 이 버튼이 뜬다.

				**행마다 버튼을 늘 세워두지 않는 이유**는 그림이다 - 목록 전체에 테두리가
				줄줄이 서면 무엇이 눌리는 것인지가 오히려 안 보인다.

				**과녁에 테두리가 있어야 하는 이유**는 안전이다. 캡처에 들어가면 그 다음
				입력이 무엇이든 단축키가 되는데(마우스 버튼도, 휠도), 들어가는 문이 안 보이면
				실수로 들어가고 들어간 줄도 모른다. 그래서 글자만 반응하게 두는 안은 버렸다.

				자리는 `BindingText`와 같은 줄, 같은 x다 - 버튼이 뜨면서 글자가 밀리면 그
				자체가 과녁을 흔든다.

				휠은 **듣는 동안 이 버튼에만** 켜진다(SetBindingMode). 목록 위에서 굴리면
				그냥 스크롤이고, 커서가 이 버튼 위에 있을 때만 휠이 단축키가 된다.
			-->
			<Button parentKey="KeyButton" inherits="UIPanelButtonTemplate" hidden="true" frameLevel="4">
				<Size x="150" y="20"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="2" y="-8"/>
				</Anchors>
				<Scripts>
					<OnClick>
						DebounceDetailPanel:RowKeyButton_OnClick(self, button);
					</OnClick>
					<OnEnter>
						DebounceDetailPanel:RowKeyButton_OnEnter(self);
					</OnEnter>
					<OnLeave>
						GameTooltip:Hide();
					</OnLeave>
					<OnKeyDown>
						DebounceDetailPanel:KeyButton_OnKeyDown(self, key);
					</OnKeyDown>
					<OnMouseWheel>
						DebounceDetailPanel:KeyButton_OnInput(delta &gt; 0 and "MOUSEWHEELUP" or "MOUSEWHEELDOWN");
					</OnMouseWheel>
					<OnGamePadButtonUp>
						DebounceDetailPanel:KeyButton_OnInput(button);
					</OnGamePadButtonUp>
					<!--
						행은 스크롤로 재사용된다. 듣던 행이 화면 밖으로 나가면 여기서 끝낸다 -
						안 그러면 보이지도 않는 버튼이 키보드를 들고 있다.
					-->
					<OnHide>
						DebounceDetailPanel:CancelKeyCaptureFor(self);
					</OnHide>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnClick method="OnClick"/>
			<!-- OnDragStart은 없다. 행은 끌 수 없고 받기만 한다(DebounceLineMixin 참고). -->
			<OnReceiveDrag method="OnReceiveDrag"/>
		</Scripts>
	</Button>

	<!--
		순서 리스트 한 줄. 왼쪽 목록(DebounceLineTemplate)과 같은 아트를 쓴다 - 한 창 안의
		두 목록이 다른 애드온처럼 보이면 안 된다. 다른 건 폭(패널에 맞춰 좁다)과, 아래줄에
		붙는 레이어·플래그 글자뿐이다.

		순위 숫자는 안 붙인다. 이 목록은 위에서부터 시도되는 순서 그대로라 자리가 곧 순위이고,
		지금 보고 있는 액션은 SelectedHighlight가 짚는다.
	-->
	<!--
		좌우 클릭이 같은 일을 한다 - 둘 다 그 액션이 사는 통으로 데려간다
		(DebounceOrderLineMixin:OnClick). 여기서 버튼을 나눌 뜻이 없다.

		실제로 한 번 열렸다. 좌클릭에 "그 액션으로 가기"를 달았는데, **좌클릭은 습관적으로
		눌러보는 버튼**이라 그것만으로 탭이 바뀌었다 - 되돌리는 데 두세 번이 든다. 멀리 가는
		일은 우클릭 메뉴에서 "가기"를 고르는 한 번의 명시적 선택이어야 한다.
	-->
	<!--
		결과 목록의 한 줄. **표의 한 행이다** - 오른쪽 통 목록과 겉이 닮으면 안 되기 때문이다.
		둘은 규칙이 다르다(이쪽은 레이어를 넘나들고 클릭이 이동이다). 겉만 같고 속이 다른
		것이 제일 나쁘므로, 저쪽은 아이콘+이름 두 줄짜리 카드로 두고 이쪽은 칸을 세운다.

		칸의 순서는 **비교자와 같다**(Ordering.lua의 CompareActionOrder): 중요도 - 호버 -
		조건 - 층. 오른쪽 정렬이라 모든 행에서 같은 칸이 같은 x에 서고, 두 행을 위아래로
		놓으면 **처음 달라지는 칸이 곧 갈린 축**이다. GetDecidingOrderAxis가 하는 계산을
		눈이 그대로 따라간다.

		호버와 조건은 켜짐/꺼짐 하나뿐이라 글자 대신 점을 찍는다. 낱말로 쓰면 칸이 넉 자씩
		차지하면서 정작 다른 칸을 밀어낸다.

		오류는 칸이 없다. 순서 축이 아니고, 이름이 이미 빨갛다
		(ColoredNameAndIconForAction). 무엇이 문제인지는 행 툴팁이 말한다.
	-->
	<Button name="DebounceOrderLineTemplate" mixin="DebounceOrderLineMixin" registerForClicks="LeftButtonUp,RightButtonUp" virtual="true">
		<Size x="300" y="24"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon">
					<Size x="18" y="18"/>
					<Anchors>
						<Anchor point="LEFT" x="2" y="0"/>
					</Anchors>
				</Texture>
				<!--
					층 칸. 아이콘 하나 = 좁혀진 축 하나 - 캐릭터 전용이면 초상화가, 일반이
					아니면 직업·전문화 아이콘이 붙는다. 아무것도 없는 행이 가장 넓은 층이다.

					여기서는 **자리를 예약한다.** 목록일 때는 빈 칸을 남기지 않는 것이 맞았지만
