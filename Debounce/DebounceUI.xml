					<Size x="35" y="35"/>
					<Anchors>
						<Anchor point="LEFT" x="18" y="0"/>
					</Anchors>
				</Texture>
				<FontString parentKey="PriorityText" inherits="GameFontNormalSmall" justifyH="RIGHT" maxLines="1">
					<Size x="86" y="0"/>
					<Anchors>
						<Anchor point="RIGHT" x="-6" y="-9"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Name" inherits="GameFontNormal" justifyH="LEFT" maxLines="1">
