	<Frame name="DebounceFrame" inherits="PortraitFrameTemplate" parent="UIParent" toplevel="true" frameStrata="MEDIUM" enableMouse="true" hidden="true" mixin="DebounceFrameMixin" movable="true" clampedToScreen="true" enableKeyboard="true">
		<Size x="440" y="620"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Frames>
			<DropdownButton parentKey="OptionsPortrait" inherits="DebouncePortraitTemplate">
				<KeyValues>
					<!-- <KeyValue key="PortraitTexture" value="Interface\WorldMap\GEAR_64GREY" type="string"/> -->
					<KeyValue key="PortraitTexture" value="Interface\Icons\pet_type_mechanical" type="string"/>
					<KeyValue key="TooltipTitle" value="OPTIONS" type="string"/>
					<KeyValue key="MenuFunc" value="SetupOptionsDropdownMenu" type="string"/>
				</KeyValues>
				<Anchors>
						<!--
						왼쪽 열 위에 고정한다. 프레임 TOPRIGHT에 붙여두면 패널이 열릴 때
						같이 오른쪽으로 끌려가서 "이 버튼들이 상세 패널 것인가"로 읽힌다.
						창 전체에 대한 버튼이므로 자리가 움직이면 안 된다.
						(409 = ScrollBoxBackground의 오른쪽 끝. 그쪽은 폭이 고정이다)
					-->
					<Anchor point="TOPRIGHT" relativePoint="TOPLEFT" x="409" y="-40"/>
				</Anchors>
			</DropdownButton>
			<DropdownButton parentKey="CustomStatesPortrait" inherits="DebouncePortraitTemplate">
				<KeyValues>
					<KeyValue key="PortraitTexture" value="254885" type="number"/>
					<KeyValue key="TooltipTitle" value="CUSTOM_STATES" type="string"/>
					<KeyValue key="TooltipText" value="CUSTOM_STATES_DESC" type="string"/>
					<KeyValue key="MenuFunc" value="SetupCustomStatesDropdownMenu" type="string"/>
				</KeyValues>
				<Anchors>
					<Anchor point="RIGHT" relativeKey="$parent.OptionsPortrait" relativePoint="LEFT" x="-5" y="0"/>
				</Anchors>
			</DropdownButton>
			<DropdownButton parentKey="AddPortrait" inherits="DebouncePortraitTemplate">
				<KeyValues>
					<KeyValue key="PortraitTexture" value="Interface\PaperDollInfoFrame\Character-Plus" type="string"/>
					<KeyValue key="TooltipTitle" value="ADD" type="string"/>
					<KeyValue key="MenuFunc" value="SetupAddDropdownMenu" type="string"/>
				</KeyValues>
				<Anchors>
					<Anchor point="RIGHT" relativeKey="$parent.CustomStatesPortrait" relativePoint="LEFT" x="-5" y="0"/>
				</Anchors>
			</DropdownButton>
			<Button parentKey="OverviewPortrait" inherits="DebouncePortraitTemplate">
				<KeyValues>
					<KeyValue key="PortraitTexture" value="Interface\Icons\inv_misc_spyglass_03" type="string"/>
					<KeyValue key="TooltipTitle" value="DEBOUNCE_OVERVIEW_TITLE" type="string"/>
				</KeyValues>
				<Anchors>
					<Anchor point="RIGHT" relativeKey="$parent.AddPortrait" relativePoint="LEFT" x="-15" y="0"/>
				</Anchors>
			</Button>
			<!--
				좌측 목록 인셋. 폭이 고정이고 왼쪽에 붙는다 - 상세 패널이 열려 프레임이 넓어져도
				이쪽은 그대로여야 한다. 마운트 창의 LeftInset과 같은 방식이다
				(Size로 폭, TOPLEFT/BOTTOMLEFT 앵커로 높이).
			-->
			<Frame parentKey="ScrollBoxBackground" useParentLevel="true" inherits="InsetFrameTemplate">
				<Size x="405" y="0"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="4" y="-85"/>
					<Anchor point="BOTTOMLEFT" x="4" y="10"/>
				</Anchors>
			</Frame>

			<Button parentKey="ScrollBox" inherits="WowScrollBoxList" frameLevel="3">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPLEFT" x="5" y ="-5"/>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollBoxBackground" relativePoint="BOTTOMRIGHT" x="-5" y ="5"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="EmptyText" hidden="true" inherits="GameFontDisable">
							<Size x="320" y="0"/>
							<Anchors>
								<Anchor point="TOP" x="0" y="-40"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Animations>
					<AnimationGroup parentKey="PageIn" setToFinalAlpha="true">
						<Alpha duration="0.3" order="1" fromAlpha="0" toAlpha="1" smoothing="IN_OUT" />
						<!-- <Translation smoothing="IN" duration="0.25" order="1" offsetX="0" offsetY="-15"/> -->
						<!-- <Translation smoothing="OUT" duration="0.25" order="1" offsetX="0" offsetY="15"/> -->
						<Scripts>
							<OnPlay>
								--self:GetParent():SetPoint("TOPLEFT", self:GetParent():GetParent(),"BOTTOMLEFT", 4, 550)
							</OnPlay>
							<OnFinished>
							</OnFinished>
						</Scripts>
					</AnimationGroup>
				</Animations>
			</Button>
			<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPRIGHT" x="5" y="-5"/>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="BOTTOMRIGHT" x="5" y="5"/>
				</Anchors>
			</EventFrame>

			<EditBox parentKey="SearchBox" inherits="SearchBoxTemplate" letters="40" hidden="false">
				<Size x="120" y="30"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPLEFT" x="4" y="2"/>
				</Anchors>
			</EditBox>

			<!--
				드래그 중에 창 안쪽을 통째로 덮는다.

				이 창은 **어디에 떨궈도** 받는다 - 떨어진 위치가 뜻을 가지지 않기 때문이다.
				그런데 행이 보이면 "어느 줄에 떨궈야 하나"라는 질문이 생기고, 행마다 툴팁이
				뜨면 행이 각각의 목적지처럼 보인다. 잠시 덮어서 그 질문 자체를 없앤다.

				상세 패널까지 덮는 이유는 캡처 오버레이와 나란히 빛나는 것을 막기 위해서다.
				드래그 중에는 드래그가 이긴다 - ESC 처리 순서가 이미 그렇게 되어 있다.

				아래 탭과 오른쪽 사이드탭은 프레임 **바깥**에 붙어 있어 덮이지 않는다.
				레이어를 옮기는 목적지라 살아 있어야 한다.
			-->
			<Frame parentKey="DropOverlay" enableMouse="true" hidden="true">
				<Anchors>
					<Anchor point="TOPLEFT" x="4" y="-85"/>
					<Anchor point="BOTTOMRIGHT" x="-4" y="10"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<!-- 캡처 오버레이와 같은 푸른 기 도는 검정. 두 덮개가 같은 뜻으로 읽혀야 한다. -->
						<Texture parentKey="Background" setAllPoints="true">
							<Color r="0.03" g="0.06" b="0.15" a="0.88"/>
						</Texture>
					</Layer>
					<Layer level="ARTWORK">
						<FontString parentKey="Prompt" inherits="GameFontNormalMed2" justifyH="CENTER" wordwrap="true">
							<Size x="300" y="0"/>
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<!-- 받을 때만 켠다. 우리 행을 끄는 중이면 목적지는 탭이고 여기는 받을 게 없다. -->
					<Frame parentKey="Glow" inherits="DebounceGlowBorderTemplate" alpha="0.55">
						<Anchors>
							<Anchor point="TOPLEFT" x="6" y="-6"/>
							<Anchor point="BOTTOMRIGHT" x="-6" y="6"/>
						</Anchors>
					</Frame>
				</Frames>
				<Scripts>
					<OnReceiveDrag>
						DebounceFrame:OnReceiveDrag();
					</OnReceiveDrag>
					<OnMouseUp>
						DebounceFrame:DropOverlay_OnMouseUp(button);
					</OnMouseUp>
				</Scripts>
			</Frame>

			<Button parentKey="Tab1" inherits="DebounceFrameTabTemplate" text="GENERAL" id="1">
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT" x="12" y="1"/>
				</Anchors>
			</Button>
			<Button parentKey="Tab2" inherits="DebounceFrameTabTemplate" id="2">
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.Tab1" relativePoint="RIGHT" x="-15" y="0"/>
				</Anchors>
			</Button>

			<Frame parentKey="SideTabsFrame">
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOPLEFT"/>
					<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT"/>
				</Anchors>
				<Frames>
					<CheckButton parentArray="Tabs" parentKey="Tab1" inherits="DebounceSideTabTemplate" id="1">
						<Anchors>
							<Anchor point="TOP" relativePoint="TOP" x="0" y="-36"/>
							<Anchor point="LEFT" relativePoint="RIGHT" x="2" y="0"/>
						</Anchors>
					</CheckButton>
					<CheckButton parentArray="Tabs" parentKey="Tab2" inherits="DebounceSideTabTemplate" id="2">
					</CheckButton>
					<CheckButton parentArray="Tabs" parentKey="Tab3" inherits="DebounceSideTabTemplate" id="3">
					</CheckButton>
					<CheckButton parentArray="Tabs" parentKey="Tab4" inherits="DebounceSideTabTemplate" id="4">
					</CheckButton>
					<CheckButton parentArray="Tabs" parentKey="Tab5" inherits="DebounceSideTabTemplate" id="5">
					</CheckButton>
					<CheckButton parentArray="Tabs" parentKey="Tab6" inherits="DebounceSideTabTemplate" id="6">
					</CheckButton>
				</Frames>
			</Frame>

			<!--
				상세 패널. 별도 창이 아니라 프레임 오른쪽에 붙는 영역이다. 액션을 고르면
				프레임이 그만큼 넓어지고, 선택을 풀면 다시 줄어든다.
				(맵 창의 QuestLogOwnerMixin:SetQuestLogPanelShown과 같은 방식 - minimizedWidth +
				detailWidth. 캐릭터창의 InsetRight Show/Hide와 같은 구조다.)

				패널 자체는 프레임 몸통이고 인셋이 아니다. 인셋은 **탭의 내용물**인
				ContentArea가 갖고, 탭은 그 윗변에 바깥에서 걸린다 - 왼쪽 목록에서
				ScrollBoxBackground가 인셋이고 탭이 몸통에 있는 것과 같은 구조다.
			-->
			<Frame parentKey="DetailPanel" name="DebounceDetailPanel" useParentLevel="true" mixin="DebounceDetailPanelMixin" enableMouse="true" hidden="true">
				<Anchors>
					<!--
						여백은 여기 한 군데에만 둔다. 담긴 게 인셋 하나뿐이라 그게 패널을 꽉
						채우고, 위아래 끝이 왼쪽 목록 인셋과 정확히 같은 선에 온다
						(ScrollBoxBackground: TOPLEFT y=-85, BOTTOMLEFT y=10 - 여기도 같은 -85 / +10이다).
					-->
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPRIGHT" x="16" y="0"/>
					<Anchor point="BOTTOMRIGHT" x="-4" y="10"/>
				</Anchors>
				<Frames>
					<!--
						패널의 내용물은 하나뿐이라 탭이 없다. 인셋의 윗변이 왼쪽 목록 인셋과
						같은 선에서 시작한다 - 나란한 두 상자가 다른 높이에서 출발하면 눈이
						기준선을 못 잡는다. 제목 줄도 없다. 어떤 액션인지는 왼쪽에서 그 행이
						강조된 것으로 말한다.
					-->
					<Frame parentKey="ContentArea" useParentLevel="true" inherits="InsetFrameTemplate" setAllPoints="true">
						<Layers>
							<Layer level="ARTWORK">
								<!--
									키가 없으면 순서 목록이 없다. 그 자리를 그냥 비워두면 덜 만든
									화면처럼 보인다. 왼쪽 목록이 비었을 때와 같은 처리다.
									(KeyArea는 Frames라 여기서 relativeKey로 못 건다 - 고정 오프셋)
								-->
								<FontString parentKey="EmptyText" inherits="GameFontDisable" justifyH="CENTER" wordwrap="true" hidden="true">
									<Size x="250" y="0"/>
									<Anchors>
										<Anchor point="TOP" x="0" y="-80"/>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
						<Frames>
							<!--
								단축키 줄. **바인딩 자체가 버튼이다** - 와우 기본 단축키 설정과 같은
								형태라 [변경] 버튼이 따로 없다. 누르면 CaptureOverlay가 열린다.

								이 줄은 캡처 중에 모습이 바뀌지 않는다. 어차피 오버레이가 덮으므로
								바꿔봐야 안 보이고, 안 바꾸면 캡처를 취소했을 때 아무것도 안 움직인다.
							-->
							<Frame parentKey="KeyArea">
								<Size y="30"/>
								<Anchors>
									<Anchor point="TOPLEFT" x="8" y="-8"/>
									<Anchor point="TOPRIGHT" x="-8" y="-8"/>
								</Anchors>
								<Layers>
									<Layer level="ARTWORK">
										<FontString parentKey="WarningText" inherits="GameFontRed" justifyH="LEFT" wordwrap="true">
											<Anchors>
												<Anchor point="TOPLEFT" x="2" y="-32"/>
												<Anchor point="TOPRIGHT" x="-2" y="-32"/>
											</Anchors>
										</FontString>
									</Layer>
								</Layers>
								<Frames>
									<!--
										상대 이동 버튼. 리스트가 아니라 패널에 고정돼 있다 - 리스트에
										붙어 있으면 연타할 때마다 버튼이 움직여서 다시 조준해야 한다.
									-->
									<Button parentKey="MoveDownButton" inherits="UIPanelSquareButton" motionScriptsWhileDisabled="true">
										<Anchors>
											<Anchor point="TOPRIGHT" x="0" y="0"/>
										</Anchors>
										<Layers>
											<Layer level="OVERLAY">
												<Texture parentKey="InfoBadge" inherits="DebounceInfoBadgeTemplate"/>
											</Layer>
										</Layers>
									</Button>
									<Button parentKey="MoveUpButton" inherits="UIPanelSquareButton" motionScriptsWhileDisabled="true">
										<Anchors>
											<Anchor point="TOPRIGHT" relativeKey="$parent.MoveDownButton" relativePoint="TOPLEFT" x="-2" y="0"/>
										</Anchors>
										<Layers>
											<Layer level="OVERLAY">
												<Texture parentKey="InfoBadge" inherits="DebounceInfoBadgeTemplate"/>
											</Layer>
										</Layers>
									</Button>
									<Button parentKey="KeyButton" inherits="UIPanelButtonTemplate" motionScriptsWhileDisabled="true">
										<Size y="26"/>
										<Anchors>
											<Anchor point="TOPLEFT" x="0" y="-1"/>
											<Anchor point="TOPRIGHT" relativeKey="$parent.MoveUpButton" relativePoint="TOPLEFT" x="-8" y="-1"/>
										</Anchors>
										<Scripts>
											<OnClick>
												DebounceDetailPanel:StartKeyCapture();
											</OnClick>
											<OnEnter>
												DebounceDetailPanel:KeyButton_OnEnter(self);
											</OnEnter>
											<OnLeave function="GameTooltip_Hide"/>
										</Scripts>
									</Button>
								</Frames>
							</Frame>

							<!--
								순서 리스트. 이 탭에서 새로 만든 건 이거 하나이므로 남는 자리는
								전부 여기로 간다. 캡처 중에도 덮이지 않는다.
							-->
							<Frame parentKey="OrderArea" hidden="true">
								<Anchors>
									<Anchor point="TOPLEFT" relativeKey="$parent.KeyArea" relativePoint="BOTTOMLEFT" x="0" y="-10"/>
									<Anchor point="BOTTOMRIGHT" x="-8" y="6"/>
								</Anchors>
								<Frames>
									<Button parentKey="ScrollBox" inherits="WowScrollBoxList">
										<Anchors>
											<Anchor point="TOPLEFT" x="0" y="0"/>
											<Anchor point="BOTTOMRIGHT" x="-14" y="0"/>
										</Anchors>
									</Button>
									<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
										<Anchors>
											<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" x="6" y="0"/>
											<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="BOTTOMRIGHT" x="6" y="0"/>
										</Anchors>
									</EventFrame>
								</Frames>
							</Frame>

							<!--
								단축키 캡처 오버레이. 패널을 통째로 덮는다 - 캡처 중에 이 패널에서 할 수 있는 일은
								키를 누르는 것뿐이고, 덮어버리면 그 사실이 화면으로 보인다.

								**마우스가 이 위에 있을 때만** 키를 가로챈다. 상설 패널이라 마우스가 딴 데 있는
								동안 키보드까지 먹으면 검색창 입력이 사라진다. 안내 문구가 "마우스를 여기 두고"로
								시작하는 건 그 제약을 숨기지 않기 위해서다.

								ESC만 호버와 무관하게 항상 닫는다. 그래서 ESC는 단축키로 지정될 수 없다.
							-->
							<Frame parentKey="CaptureOverlay" enableMouse="true" enableKeyboard="true" setAllPoints="true" hidden="true">
								<Layers>
									<Layer level="BACKGROUND">
										<!--
											순수 검정으로 덮으면 패널이 "꺼진" 것처럼 보인다. 푸른 기를
											넣으면 덮개가 씌워진 것으로 읽힌다 - 같은 어둡기인데 의도가
											보인다.
										-->
										<Texture parentKey="Background" setAllPoints="true">
											<Color r="0.03" g="0.06" b="0.15" a="0.88"/>
										</Texture>
									</Layer>
									<Layer level="ARTWORK">
																				<!--
											이건 곁다리 설명이 아니라 **지금 무엇을 하라는 말**이다. 그래서 기본 노란색
											(GameFontNormal)을 쓴다. 흰색·회색은 부연에 쓴다.

											위에서 마진을 두고 시작한다. CENTER로 걸면 글의 **시작점**이 패널 한가운데가
											되고 힌트와 버튼이 거기서부터 아래로 달려서 덩어리 전체가 쳐져 보인다.
											-80은 빈 패널 안내문(EmptyText)이 쓰는 것과 같은 값이다.
										-->
										<FontString parentKey="Prompt" inherits="GameFontNormalMed2" justifyH="CENTER" wordwrap="true">
											<Size x="260" y="0"/>
											<Anchors>
												<Anchor point="TOP" x="0" y="-80"/>
											</Anchors>
										</FontString>
										<FontString parentKey="Hint" inherits="GameFontDisable" justifyH="CENTER" wordwrap="true">
											<Size x="260" y="0"/>
											<Anchors>
												<Anchor point="TOP" relativeKey="$parent.Prompt" relativePoint="BOTTOM" x="0" y="-8"/>
											</Anchors>
										</FontString>
									</Layer>
								</Layers>
								<Frames>
									<!--
										테두리 글로우. 어둡게 덮는 것만으로는 눈길이 가지 않는다 -
										**움직임**이 있어야 시선이 온다. 그래서 천천히 밝기가 오간다.
										왼쪽 목록에서 행을 강조할 때 쓰는 것과 같은 글로우다.

										템플릿의 텍스처가 프레임 밖으로 8px 나가므로 6만큼 안으로
										들여서 걸면 글로우가 패널 테두리에 얹힌다.
									-->
									<Frame parentKey="Glow" inherits="DebounceGlowBorderTemplate" alpha="0.4">
										<Anchors>
											<Anchor point="TOPLEFT" x="6" y="-6"/>
											<Anchor point="BOTTOMRIGHT" x="-6" y="6"/>
										</Anchors>
										<Animations>
											<AnimationGroup parentKey="Pulse" looping="BOUNCE">
												<Alpha duration="0.9" fromAlpha="0.35" toAlpha="0.9" order="1"/>
											</AnimationGroup>
										</Animations>
										<Scripts>
											<OnShow>
												self.Pulse:Play();
											</OnShow>
											<OnHide>
												self.Pulse:Stop();
											</OnHide>
										</Scripts>
									</Frame>
									<Button parentKey="UnbindButton" inherits="UIPanelButtonTemplate">
										<Size x="150" y="22"/>
										<Anchors>
											<Anchor point="TOP" relativeKey="$parent.Hint" relativePoint="BOTTOM" x="0" y="-20"/>
										</Anchors>
										<Scripts>
											<OnClick>
												DebounceDetailPanel:UnbindKey();
											</OnClick>
										</Scripts>
									</Button>
									<!-- 해제 버튼이 없는 액션에서는 Lua가 이 앵커를 안내문 바로 아래로 다시 잡는다. -->
									<Button parentKey="CancelButton" inherits="UIPanelButtonTemplate">
										<Size x="150" y="22"/>
										<Anchors>
											<Anchor point="TOP" relativeKey="$parent.UnbindButton" relativePoint="BOTTOM" x="0" y="-6"/>
										</Anchors>
										<Scripts>
											<OnClick>
												DebounceDetailPanel:CancelKeyCapture();
											</OnClick>
										</Scripts>
									</Button>
								</Frames>
								<Scripts>
									<OnKeyDown>
										DebounceDetailPanel:KeyCapture_OnKeyDown(self, key);
									</OnKeyDown>
									<OnMouseUp>
										DebounceDetailPanel:KeyCapture_ProcessInput(button);
									</OnMouseUp>
									<OnMouseWheel>
										DebounceDetailPanel:KeyCapture_ProcessInput(delta &gt; 0 and "MOUSEWHEELUP" or "MOUSEWHEELDOWN");
									</OnMouseWheel>
									<OnGamePadButtonDown>
										DebounceDetailPanel:KeyCapture_ProcessInput(button);
									</OnGamePadButtonDown>
								</Scripts>
							</Frame>

							<!--
								매크로 편집 오버레이. 캡처 오버레이와 같은 자리를 쓴다 - 이 패널은 한 번에 한 가지
								일만 한다.

