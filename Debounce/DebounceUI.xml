	<!-- ESC는 이 창이 직접 받는다(enableKeyboard). 블리자드가 내주는 두 자리 - UISpecialFrames와
	     RegisterGameMenuEscHandler - 를 둘 다 안 쓰는 이유가 DebounceFrameMixin:OnLoad에 있다. -->
	<Frame name="DebounceFrame" inherits="PortraitFrameTemplate" parent="UIParent" toplevel="true" frameStrata="MEDIUM" enableMouse="true" hidden="true" mixin="DebounceFrameMixin" movable="true" clampedToScreen="true" enableKeyboard="true">
		<Size x="440" y="620"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Frames>
			<DropdownButton parentKey="OptionsPortrait" inherits="DebouncePortraitTemplate">
				<KeyValues>
					<!-- <KeyValue key="PortraitTexture" value="Interface\WorldMap\GEAR_64GREY" type="string"/> -->
					<KeyValue key="PortraitTexture" value="Interface\Icons\pet_type_mechanical" type="string"/>
					<KeyValue key="TooltipTitle" value="OPTIONS" type="string"/>
					<KeyValue key="MenuFunc" value="SetupOptionsDropdownMenu" type="string"/>
				</KeyValues>
				<Anchors>
					<!--
						통 위에 선다. 셋 중 [+ 추가]가 통에 넣는 버튼이라 그 열 위여야 하고,
						나머지 둘도 같은 줄에 있는 편이 한 덩어리로 읽힌다.
						(오른쪽 끝은 ScrollBoxBackground의 오른쪽 끝에 맞춘다)
					-->
					<Anchor point="TOPRIGHT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPRIGHT" x="0" y="45"/>
				</Anchors>
			</DropdownButton>
			<DropdownButton parentKey="CustomStatesPortrait" inherits="DebouncePortraitTemplate">
				<KeyValues>
					<KeyValue key="PortraitTexture" value="254885" type="number"/>
					<KeyValue key="TooltipTitle" value="CUSTOM_STATES" type="string"/>
					<KeyValue key="TooltipText" value="CUSTOM_STATES_DESC" type="string"/>
					<KeyValue key="MenuFunc" value="SetupCustomStatesDropdownMenu" type="string"/>
				</KeyValues>
				<Anchors>
					<Anchor point="RIGHT" relativeKey="$parent.OptionsPortrait" relativePoint="LEFT" x="-5" y="0"/>
				</Anchors>
			</DropdownButton>
			<!--
				**메뉴가 아니라 창을 연다.** 한때 여기 드롭다운이 매달려 있었고 그 안에
				타입별 하위 메뉴가 아홉 겹까지 들어갔는데, 지금은 그 항목이 전부 주문 선택
				창에 있다 - 검색까지 되는 자리라 메뉴로 남길 이유가 없어졌다.

				그래서 `DropdownButton`이 아니라 평범한 `Button`이다. 클릭은
				`DebounceFrameMixin:InitializeButtons`에서 붙인다(오버뷰 버튼과 같은 방식).
			-->
			<Button parentKey="AddPortrait" inherits="DebouncePortraitTemplate">
				<KeyValues>
					<KeyValue key="PortraitTexture" value="Interface\PaperDollInfoFrame\Character-Plus" type="string"/>
					<!--
						제목은 **열리는 창의 제목 그대로**다. "Add..."라는 이 버튼만의
						낱말을 따로 갖고 있었는데, 눌러서 뜬 창이 "Add an Action"이라고
						적혀 있으면 같은 것인지 알 수가 없다.
					-->
					<KeyValue key="TooltipTitle" value="SPELL_PICKER_TITLE" type="string"/>
					<KeyValue key="TooltipText" value="SPELL_PICKER_MENU_DESC" type="string"/>
				</KeyValues>
				<Anchors>
					<Anchor point="RIGHT" relativeKey="$parent.CustomStatesPortrait" relativePoint="LEFT" x="-5" y="0"/>
				</Anchors>
			</Button>
			<!--
				**통.** 지금 고른 레이어에 담긴 액션 목록이고, 창의 오른쪽에 산다.

				오른쪽인 이유는 왼쪽이 결과이기 때문이다 - 통에 넣으면 왼쪽에 나타난다는
				인과가 한 화면에 있어야 레이어가 무엇을 하는지가 화면으로 설명된다.
				드롭도 여기만 받는다(왼쪽은 사영이라 어느 레이어인지 답이 없다).

				폭이 고정이고 오른쪽에 붙는다. 오른쪽 여백 20은 스크롤바 자리다 - 그건
				인셋 바깥에 서고, 사이드탭은 그보다 더 바깥(창 밖)이라 겹치지 않는다.
			-->
			<Frame parentKey="ScrollBoxBackground" useParentLevel="true" inherits="InsetFrameTemplate">
				<Size x="375" y="0"/>
				<Anchors>
					<Anchor point="TOPRIGHT" x="-20" y="-85"/>
					<Anchor point="BOTTOMRIGHT" x="-20" y="10"/>
				</Anchors>
				<Frames>
					<!--
						커서에 뭔가 들려 있는 동안 켜진다 - "여기가 받는다".

						**인셋의 테두리 자리에 앉는다.** 3px 안쪽이라 5px에서 시작하는
						ScrollBox와 안 겹치고, 그래서 행 위에 뭘 덮지 않는다. 목록을 가리지
						않고 목록이 빛나는 게 이 표시의 전부다.

						상세 패널은 안 빛난다. 저기엔 떨굴 데가 없다.
					-->
					<Frame parentKey="Highlight" inherits="DebounceGlowBorderTemplate" hidden="true" alpha="0.4">
						<Anchors>
							<Anchor point="TOPLEFT" x="3" y="-3"/>
							<Anchor point="BOTTOMRIGHT" x="-3" y="3"/>
						</Anchors>
					</Frame>
				</Frames>
			</Frame>

			<Button parentKey="ScrollBox" inherits="WowScrollBoxList" frameLevel="3">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPLEFT" x="5" y ="-5"/>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollBoxBackground" relativePoint="BOTTOMRIGHT" x="-5" y ="5"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="EmptyText" hidden="true" inherits="GameFontDisable">
							<Size x="320" y="0"/>
							<Anchors>
								<Anchor point="TOP" x="0" y="-40"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Animations>
					<AnimationGroup parentKey="PageIn" setToFinalAlpha="true">
						<Alpha duration="0.3" order="1" fromAlpha="0" toAlpha="1" smoothing="IN_OUT" />
						<!-- <Translation smoothing="IN" duration="0.25" order="1" offsetX="0" offsetY="-15"/> -->
						<!-- <Translation smoothing="OUT" duration="0.25" order="1" offsetX="0" offsetY="15"/> -->
						<Scripts>
							<OnPlay>
								--self:GetParent():SetPoint("TOPLEFT", self:GetParent():GetParent(),"BOTTOMLEFT", 4, 550)
							</OnPlay>
							<OnFinished>
							</OnFinished>
						</Scripts>
					</AnimationGroup>
				</Animations>
			</Button>
			<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPRIGHT" x="5" y="-5"/>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="BOTTOMRIGHT" x="5" y="5"/>
				</Anchors>
			</EventFrame>

			<EditBox parentKey="SearchBox" inherits="SearchBoxTemplate" letters="40" hidden="false">
				<Size x="120" y="30"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPLEFT" x="4" y="2"/>
				</Anchors>
			</EditBox>

			<!--
				목록을 단축키로 묶을지. **정렬 모드가 아니다** - 줄 순서는 묶든 안 묶든 이름순이고
				이 체크박스는 키가 바뀌는 자리에 선을 그을지만 정한다. 이유는
				`BuildSortedElements`(DebounceUI.lua)에 있다.

				옵션 메뉴가 아니라 목록 위에 두는 이유, 라벨/툴팁을 Lua에서 붙이는 이유는
				`DebounceFrameMixin:InitializeButtons`에.
			-->
			<CheckButton parentKey="GroupByKeyCheckButton" inherits="UICheckButtonTemplate">
				<Size x="24" y="24"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.SearchBox" relativePoint="RIGHT" x="6" y="0"/>
				</Anchors>
			</CheckButton>

			<!--
				레이어 탭은 **통 아래**에 선다. 고르는 것이 "어느 통을 보고 있나"라서 그
				열에 붙어 있어야 하고, 왼쪽(결과)에는 고를 통이 없다.

				y는 프레임 BOTTOMLEFT에 매달렸을 때와 같은 높이가 되게 잡는다
				(인셋 바닥이 프레임 바닥에서 +10이므로 거기서 -9).
			-->
			<Button parentKey="Tab1" inherits="DebounceFrameTabTemplate" text="GENERAL" id="1">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="BOTTOMLEFT" x="8" y="-9"/>
				</Anchors>
			</Button>
			<!--
				오프셋은 `PanelTemplates_AnchorTabs`가 쓰는 값과 같다(TOPLEFT→TOPRIGHT, +3).
				여기 뭘 적든 `PanelTemplates_SetNumTabs`가 2번 탭부터 앵커를 덮어쓰므로 이
				값은 화면에 닿지 않지만, 실제와 다른 숫자를 적어두면 이 파일을 본보기로 삼는
				쪽이 그걸 그대로 베낀다 - 스펠 피커가 한때 그렇게 캡이 포개져 있었다.
			-->
			<Button parentKey="Tab2" inherits="DebounceFrameTabTemplate" id="2">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Tab1" relativePoint="TOPRIGHT" x="3" y="0"/>
				</Anchors>
			</Button>

			<Frame parentKey="SideTabsFrame">
				<Anchors>
					<Anchor point="TOPLEFT" relativePoint="TOPLEFT"/>
					<Anchor point="BOTTOMRIGHT" relativePoint="BOTTOMRIGHT"/>
				</Anchors>
				<Frames>
					<CheckButton parentArray="Tabs" parentKey="Tab1" inherits="DebounceSideTabTemplate" id="1">
						<Anchors>
							<Anchor point="TOP" relativePoint="TOP" x="0" y="-36"/>
							<Anchor point="LEFT" relativePoint="RIGHT" x="2" y="0"/>
						</Anchors>
					</CheckButton>
					<CheckButton parentArray="Tabs" parentKey="Tab2" inherits="DebounceSideTabTemplate" id="2">
					</CheckButton>
					<CheckButton parentArray="Tabs" parentKey="Tab3" inherits="DebounceSideTabTemplate" id="3">
					</CheckButton>
					<CheckButton parentArray="Tabs" parentKey="Tab4" inherits="DebounceSideTabTemplate" id="4">
					</CheckButton>
					<CheckButton parentArray="Tabs" parentKey="Tab5" inherits="DebounceSideTabTemplate" id="5">
					</CheckButton>
					<CheckButton parentArray="Tabs" parentKey="Tab6" inherits="DebounceSideTabTemplate" id="6">
					</CheckButton>
				</Frames>
			</Frame>

			<!--
				**결과.** 창의 왼쪽에 상설로 선다 - 접히지 않는다.

				접는 길을 안 두는 이유는 자리가 아깝지 않아서가 아니라, 오른쪽 통이
				optional이 되면 레이어가 "가끔 여는 것"이 되어 멘탈모델이 안 잡히기
				때문이다. 둘은 한 쌍이라 늘 같이 서 있어야 한다.

				같은 이유로 **선택 하나에 창 폭이 변하지 않는다.** 행을 고르는 건 이 창에서
				제일 가벼운 제스처인데, 그것 때문에 창이 자라면 방금 누른 행이 화면에서
				움직인다(clampedToScreen이 창을 되밀기까지 한다).

				패널 자체는 프레임 몸통이고 인셋이 아니다. 인셋은 안에 담긴 ContentArea가
				갖는다 - 오른쪽에서 ScrollBoxBackground가 인셋인 것과 같은 구조다.
			-->
			<Frame parentKey="DetailPanel" name="DebounceDetailPanel" useParentLevel="true" mixin="DebounceDetailPanelMixin" enableMouse="true">
				<Anchors>
					<!--
						위아래 끝이 오른쪽 목록 인셋과 정확히 같은 선에 온다
						(ScrollBoxBackground: -85 / +10 - 여기도 같은 값이다). 나란한 두 상자가
						다른 높이에서 출발하면 눈이 기준선을 못 잡는다.
					-->
					<Anchor point="TOPLEFT" x="4" y="-85"/>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollBoxBackground" relativePoint="BOTTOMLEFT" x="-16" y="0"/>
				</Anchors>
				<Frames>
					<Frame parentKey="ContentArea" useParentLevel="true" inherits="InsetFrameTemplate" setAllPoints="true">
						<Layers>
							<Layer level="ARTWORK">
								<!--
									고른 것이 없을 때. 패널이 접히지 않으므로 빈 자리가 늘 보이고,
									빈 자리는 무엇을 하면 채워지는지 말해야 한다. 오른쪽 목록이
									비었을 때와 같은 모양이다(가운데 회색 한 문장).
								-->
								<FontString parentKey="EmptyText" inherits="GameFontDisable" justifyH="CENTER" wordwrap="true" hidden="true">
									<Size x="260" y="0"/>
									<Anchors>
										<Anchor point="TOP" x="0" y="-60"/>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
						<Frames>
							<!--
								**결과 목록.** 활성 레이어에서 키가 걸린 액션 전부를 키로 묶고, 그룹
								안은 실제 발동 순서로 놓는다. 이 열에 담긴 것은 이것 하나뿐이라
								자리를 전부 쓴다.

								단축키를 **보여주기만** 한다. 거는 자리는 오른쪽 행의 키 칸이다 -
								여기 행은 남의 레이어 것일 수 있고, 이 목록은 사영이라 "어느 통에
								넣을까"에 답이 없다.
							-->
							<Frame parentKey="OrderArea" hidden="true">
								<Anchors>
									<Anchor point="TOPLEFT" x="8" y="-8"/>
									<Anchor point="BOTTOMRIGHT" x="-8" y="6"/>
								</Anchors>
								<Frames>
									<Button parentKey="ScrollBox" inherits="WowScrollBoxList">
										<Anchors>
											<Anchor point="TOPLEFT"/>
											<Anchor point="BOTTOMRIGHT"/>
										</Anchors>
									</Button>
									<!--
										**스크롤바는 인셋 밖에 선다.** 오른쪽 목록이 그렇게 서 있고
										(ScrollBoxBackground의 TOPRIGHT에서 +5), 두 열 사이 홈통이 바로
										그 자리다. 안쪽에 두면 목록이 그만큼 좁아지는데 홈통은 빈 채로
										남는다 - 자리를 두 번 내주는 셈이다.

										+13은 인셋 안쪽 여백 8을 건너뛴 뒤의 +5다. 오른쪽과 같은 값이라
										두 스크롤바가 각자 인셋에서 같은 거리에 선다.
									-->
									<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
										<Anchors>
											<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBox" relativePoint="TOPRIGHT" x="13" y="0"/>
											<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBox" relativePoint="BOTTOMRIGHT" x="13" y="0"/>
										</Anchors>
									</EventFrame>
								</Frames>
							</Frame>
						</Frames>
					</Frame>
				</Frames>
				<Scripts>
					<OnLoad method="OnLoad"/>
				</Scripts>
			</Frame>
		</Frames>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="CombatText" inherits="GameFontRed" justifyH="LEFT">
					<Anchors>
						<Anchor point="TOPLEFT" relativePoint="TOPLEFT" x="60" y="-30"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="UnboundText" inherits="GameFontRed">
					<Anchors>
						<Anchor point="CENTER" relativePoint="BOTTOM" x="0" y="40"/>
					</Anchors>
				</FontString>

			</Layer>
		</Layers>
		<Scripts>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
			<OnEvent method="OnEvent"/>
			<OnKeyDown method="OnKeyDown"/>
		</Scripts>
	</Frame>

	<!--
		매크로 편집 창. 한때 상세 패널의 두 번째 탭이었다가 다시 창으로 나왔다.

		탭이었을 때의 값은 "패널이 늘 떠 있으니 팝업이 필요 없다"였는데, 매크로가 아닌 액션
		에서는 그 탭이 **"이건 매크로가 아닙니다"만 말하는 자리**였다. 액션 대부분이 주문인
		사람에게는 탭 하나가 늘 헛돌고, 그 탭 바가 먹는 자리는 순서 목록이 쓸 자리였다.

		저장 규칙은 탭이었을 때와 같다 - **떠날 때 저장**(기본 매크로 창과 같다). 창에서는
		닫는 것이 곧 떠나는 것이고, 버리는 길은 [취소] 하나뿐이다.

		매크로텍스트가 아닌 액션으로도 열린다(ConvertPrompt). 우클릭 메뉴의 [매크로 텍스트로
		전환]과 같은 자리라, 바꿀 수 있는지와 왜 안 되는지를 여기서 말한다.
	-->
	<Frame name="DebounceMacroFrame" mixin="DebounceMacroFrameMixin" toplevel="true" movable="true" frameStrata="HIGH" parent="DebounceFrame" hidden="true" enableMouse="true">
		<Size x="338" y="410"/>
		<Anchors>
			<Anchor point="TOPLEFT" relativePoint="TOPRIGHT" x="0" y="0"/>
		</Anchors>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="BG">
					<Anchors>
						<Anchor point="TOPLEFT" x="7" y="-7"/>
						<Anchor point="BOTTOMRIGHT" x="-7" y="7"/>
					</Anchors>
					<Color r="0" g="0" b="0" a=".80"/>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame parentKey="BorderBox" inherits="NineSlicePanelTemplate" frameLevel="50" setAllPoints="true">
				<KeyValues>
					<KeyValue key="layoutType" value="Dialog" type="string"/>
				</KeyValues>
			</Frame>

			<Button parentKey="CloseButton" inherits="UIPanelCloseButton" frameLevel="60">
				<Anchors>
					<Anchor point="TOPRIGHT" x="-2" y="-2"/>
				</Anchors>
				<Scripts>
					<OnClick>
						DebounceMacroFrame:Close();
					</OnClick>
				</Scripts>
			</Button>

			<Frame parentKey="Editor" hidden="true">
				<Anchors>
					<Anchor point="TOPLEFT" x="14" y="-14"/>
					<Anchor point="BOTTOMRIGHT" x="-14" y="14"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture parentKey="SelectedMacroBackground" file="Interface\Buttons\UI-EmptySlot">
							<Size x="64" y="64"/>
							<Anchors>
								<Anchor point="TOPLEFT" x="0" y="0"/>
							</Anchors>
						</Texture>
						<FontString parentKey="SelectedMacroName" inherits="GameFontNormal" justifyH="LEFT" maxLines="1">
							<Size x="200" y="16"/>
							<Anchors>
								<Anchor point="TOPLEFT" relativeKey="$parent.SelectedMacroBackground" relativePoint="TOPRIGHT" x="-4" y="-12"/>
							</Anchors>
						</FontString>
						<FontString parentKey="EnterMacroText" inherits="GameFontHighlightSmall" text="ENTER_MACRO_LABEL">
							<Anchors>
								<Anchor point="TOPLEFT" x="4" y="-70"/>
							</Anchors>
						</FontString>
						<!-- 글자 수는 편집칸 아래 왼쪽. 오른쪽 자리는 [취소]가 쓴다. -->
						<FontString parentKey="CharLimitText" inherits="GameFontHighlightSmall" justifyH="LEFT">
							<Anchors>
								<Anchor point="BOTTOMLEFT" x="4" y="6"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<CheckButton parentKey="SelectedMacroButton" inherits="DebounceMacroButtonTemplate" id="0">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.SelectedMacroBackground" x="14" y="-14"/>
						</Anchors>
						<Scripts>
							<OnClick>
								self:SetChecked(false);
							</OnClick>
						</Scripts>
					</CheckButton>
					<Button parentKey="EditButton" inherits="UIPanelButtonTemplate" text="CHANGE_MACRO_NAME_ICON">
						<Size x="170" y="22"/>
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.SelectedMacroBackground" x="55" y="-30"/>
						</Anchors>
						<Scripts>
							<OnClick>
								DebounceMacroFrame:EditNameIcon_OnClick();
							</OnClick>
						</Scripts>
					</Button>
					<!--
						안쪽 여백(둘레 10px, 오른쪽은 스크롤바 자리 24px)도 눈에는 편집칸이다.
						거기서 클릭이 죽으면 "눌리는 데가 따로 있다"가 되므로 여기서 받아 넘긴다.
						스크롤 영역보다 아래 단이라 편집칸 자체의 클릭은 가져가지 않는다.
					-->
					<Frame parentKey="EditBackdrop" inherits="TooltipBackdropTemplate" enableMouse="true">
						<Anchors>
							<Anchor point="TOPLEFT" x="0" y="-86"/>
							<Anchor point="BOTTOMRIGHT" x="0" y="32"/>
						</Anchors>
						<Scripts>
							<OnMouseDown>
								self:GetParent().ScrollFrame.EditBox:SetFocus();
							</OnMouseDown>
						</Scripts>
					</Frame>
					<ScrollFrame parentKey="ScrollFrame" inherits="DebounceScrollFrameTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.EditBackdrop" x="10" y="-10"/>
							<Anchor point="BOTTOMRIGHT" relativeKey="$parent.EditBackdrop" x="-24" y="10"/>
						</Anchors>
						<ScrollChild>
							<!-- 크기는 OnLoad가 스크롤 영역에 맞춘다(기본 매크로 창도 둘이 같은 크기다). -->
							<EditBox parentKey="EditBox" multiLine="true" letters="1000" autoFocus="false" countInvisibleLetters="true">
								<Size x="286" y="380"/>
								<Scripts>
									<OnLoad>
										ScrollingEdit_OnCursorChanged(self, 0, 0, 0, 0);
									</OnLoad>
									<OnTextChanged>
										DebounceMacroFrame:Text_OnTextChanged(self);
									</OnTextChanged>
									<!--
										마지막 줄 **아래 빈 자리**를 눌러도 포커스가 와야 한다. 여러 줄
										EditBox는 글자가 있는 자리를 눌렀을 때만 스스로 포커스를 잡고,
										빈 자리는 클릭을 먹고 아무것도 하지 않는다. 매크로 두 줄짜리면
										상자의 대부분이 그 빈 자리다.

										블리자드도 EventEditBox에서 같은 자리를 같은 한 줄로 메운다
										(OnMouseDown_Intrinsic → SetFocus). 이미 포커스가 있으면 무시된다.
									-->
									<OnMouseDown>
										self:SetFocus();
									</OnMouseDown>
									<OnCursorChanged function="ScrollingEdit_OnCursorChanged"/>
									<OnUpdate>
										ScrollingEdit_OnUpdate(self, elapsed, self:GetParent());
									</OnUpdate>
									<OnEscapePressed function="EditBox_ClearFocus"/>
								</Scripts>
								<FontString inherits="GameFontHighlightSmall"/>
							</EditBox>
						</ScrollChild>
					</ScrollFrame>
					<Button parentKey="CancelButton" inherits="UIPanelButtonTemplate" text="CANCEL">
						<Size x="90" y="22"/>
						<Anchors>
							<Anchor point="BOTTOMRIGHT" x="0" y="0"/>
						</Anchors>
						<Scripts>
							<OnClick>
								DebounceMacroFrame:Cancel_OnClick();
							</OnClick>
						</Scripts>
					</Button>
				</Frames>
			</Frame>

			<!--
				매크로텍스트가 아닌 액션으로 열렸을 때. 바꿀 수 있으면 그 버튼이, 없으면 왜
				안 되는지가 온다. 자리는 왼쪽 목록이 비었을 때와 같은 모양이다(가운데 회색 한 문장).
			-->
			<Frame parentKey="ConvertPrompt" hidden="true">
				<Anchors>
					<Anchor point="TOPLEFT" x="14" y="-14"/>
					<Anchor point="BOTTOMRIGHT" x="-14" y="14"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Message" inherits="GameFontDisable" justifyH="CENTER" wordwrap="true">
							<Size x="260" y="0"/>
							<Anchors>
								<Anchor point="TOP" x="0" y="-72"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Button parentKey="ConvertButton" inherits="UIPanelButtonTemplate">
						<Size x="280" y="22"/>
						<Anchors>
							<Anchor point="TOP" relativeKey="$parent.Message" relativePoint="BOTTOM" x="0" y="-14"/>
						</Anchors>
						<Scripts>
							<OnClick>
								DebounceMacroFrame:Convert_OnClick();
							</OnClick>
						</Scripts>
					</Button>
				</Frames>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnHide method="OnHide"/>
			<OnMouseDown>
				self:StartMoving();
			</OnMouseDown>
			<OnMouseUp>
				self:StopMovingOrSizing();
			</OnMouseUp>
		</Scripts>
	</Frame>

	<Frame name="DebounceIconSelectorFrame" mixin="DebounceIconSelectorFrameMixin" inherits="IconSelectorPopupFrameTemplate" toplevel="true" frameStrata="HIGH" parent="DebounceFrame" movable="true" enableMouse="true" hidden="true">
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>


	<Frame name="DebounceStateDriverUpdateThrottleSliderTemplate" mixin="DebounceStateDriverUpdateThrottleSliderMixin" virtual="true">
		<Size x="200" y="16"/>
		<Frames>
			<Frame parentKey="ValueText" name="ValueText" inherits="PropertyFontStringTemplate">
				<Size x="32" y="0"/>
				<Anchors>
					<Anchor point="TOPRIGHT"/>
					<Anchor point="BOTTOMRIGHT"/>
				</Anchors>
			</Frame>
			<Slider parentKey="Slider" name="Slider" minValue="0" maxValue="0.2" valueStep="0.01" obeyStepOnDrag="true" inherits="PropertySliderTemplate">
				<Size x="0" y="17"/>
				<Anchors>
					<Anchor point="LEFT" />
					<Anchor point="RIGHT" relativeKey="$parent.ValueText" relativePoint="LEFT" x="-5" y="0"/>
				</Anchors>
				<Scripts>
					<!-- <OnLoad method="OnLoad" inherit="append"/> -->
				</Scripts>
			</Slider>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad" />
		</Scripts>
	</Frame>

</Ui>
