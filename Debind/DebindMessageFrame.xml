<Ui xmlns="http://www.blizzard.com/wow/ui/"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/FrameXML/UI.xsd">

	<!--
		The help window: a back button and a page picker on top, and the page under it.

		**Not a `StaticPopup`**, because that has no place for a name above its text, and the name ends
		up as the body's first line.

		**The height is fixed and the body scrolls.** A window sized to its text assumes the text fits
		on the screen, which a long page in a long language does not.

		**After `DebindUI.xml` in the `.toc`**, for `DebindScrollFrameTemplate`.

		**`DefaultPanelTemplate`, which is the main window's `PortraitFrameTemplate` without the
		portrait** and what the game's own `HelpFrame` is. It brings no close button, so one is added
		the way `HelpFrame` adds it.
	-->
	<Frame name="DebindMessageFrame" inherits="DefaultPanelTemplate" parent="UIParent" toplevel="true"
		frameStrata="DIALOG" enableMouse="true" hidden="true" movable="true" clampedToScreen="true"
		mixin="DebindMessageFrameMixin">
		<Size x="560" y="540"/>
		<Anchors>
			<Anchor point="CENTER" x="0" y="60"/>
		</Anchors>
		<Frames>
			<Button parentKey="CloseButton" inherits="UIPanelCloseButtonDefaultAnchors"/>
			<Button parentKey="BackButton" inherits="SquareIconButtonTemplate">
				<Size x="28" y="28"/>
				<KeyValues>
					<KeyValue key="iconAtlas" value="common-icon-backarrow" type="string"/>
					<KeyValue key="iconSize" value="16" type="number"/>
					<KeyValue key="tooltipTitle" value="BACK" type="global"/>
				</KeyValues>
				<Anchors>
					<Anchor point="TOPLEFT" x="13" y="-33"/>
				</Anchors>
			</Button>
			<!--
				**The right edge is anchored in `OnLoad`**, to the scroll bar, which `ScrollFrame_OnLoad`
				makes after this frame is read.
			-->
			<DropdownButton parentKey="Dropdown" inherits="WowStyle1DropdownTemplate">
				<Size x="0" y="26"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.BackButton" relativePoint="RIGHT" x="4" y="0"/>
				</Anchors>
			</DropdownButton>
			<ScrollFrame parentKey="ScrollFrame" inherits="DebindScrollFrameTemplate">
				<Anchors>
					<!-- On the window and not under the picker: the picker's right edge hangs off this
					     frame's scroll bar, and the two would each wait on the other. -->
					<Anchor point="TOPLEFT" x="20" y="-74"/>
					<Anchor point="BOTTOMRIGHT" x="-36" y="18"/>
				</Anchors>
				<ScrollChild>
					<!--
						**The height is set by `ShowTopic`**, which measures the page.

						**`hyperlinksEnabled` is on this frame.** A link's click goes to the frame
						holding the FontString it is drawn in, and the body's FontStrings are made on
						this one.
					-->
					<Frame parentKey="Content" enableMouse="true" hyperlinksEnabled="true">
						<Size x="502" y="1"/>
						<Layers>
							<Layer level="ARTWORK">
								<FontString parentKey="Title" inherits="GameFontHighlightLarge" justifyH="LEFT" wordwrap="true">
									<Anchors>
										<Anchor point="TOPLEFT"/>
										<Anchor point="TOPRIGHT"/>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
						<Scripts>
							<OnHyperlinkClick>
								DebindMessageFrame:OnHyperlinkClick(link);
							</OnHyperlinkClick>
						</Scripts>
					</Frame>
				</ScrollChild>
			</ScrollFrame>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
		</Scripts>
	</Frame>

</Ui>
