<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

	<Script file="ArrivalSwitchesUI.lua"/>

	<!--
		What accepting an arrival puts up when a switch its actions bring conflicts with the reader's
		(`resolving-switches-on-accept.md` 6). The rows depend on what is asked, so they are made in
		Lua inside the scroll child; the height follows them up to a cap.
	-->
	<Frame name="DebindArrivalSwitchesFrame" inherits="DebindDialogTemplate" mixin="DebindArrivalSwitchesFrameMixin">
		<Size x="520" y="300"/>
		<Frames>
			<Button parentKey="AcceptButton" inherits="UIPanelButtonTemplate" text="OKAY">
				<Size x="120" y="22"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ContentArea" relativePoint="BOTTOM" x="-5" y="0"/>
				</Anchors>
			</Button>
			<Button parentKey="CancelButton" inherits="UIPanelButtonTemplate" text="CANCEL">
				<Size x="120" y="22"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ContentArea" relativePoint="BOTTOM" x="5" y="0"/>
				</Anchors>
			</Button>
			<ScrollFrame parentKey="Scroll" inherits="ScrollFrameTemplate">
				<ScrollChild>
					<Frame parentKey="Child">
						<Size x="420" y="10"/>
					</Frame>
				</ScrollChild>
			</ScrollFrame>
		</Frames>
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="Text" inherits="GameFontNormal" justifyH="LEFT" wordwrap="true">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.ContentArea" relativePoint="TOPLEFT"/>
						<Anchor point="TOPRIGHT" relativeKey="$parent.ContentArea" relativePoint="TOPRIGHT"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnHide method="OnDialogHide"/>
		</Scripts>
	</Frame>
</Ui>
