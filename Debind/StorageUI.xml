<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

	<Script file="StorageUI.lua"/>

	<!--
		One entry: whose it is, how much is in it, and when it turned up.

		Same row art as everywhere else this addon draws a list, so the column reads as part of the
		same window rather than a settings screen that wandered in.

		**Clicking the row picks it**, and the right column shows what is in it. It used to open a
		dialog and start an import - a row that acts rather than a row that is chosen - which there
		was nothing to choose it *for* until there was a second column to read. The delete button
		still takes its own click.
	-->
	<Button name="DebindStorageEntryRowTemplate" mixin="DebindStorageEntryRowMixin" virtual="true">
		<Size x="400" y="44"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" atlas="ClickCastList-ButtonBackground">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<!--
					**The two things the string itself always carries**: the sender's class, in that
					class's colour, and when it was received.

					It used to be the free text typed at paste time, falling back to a stand-in that
					said "Received string" - which is what three rows in a row read like, so the
					line told them apart from nothing. That text is optional and now lives in the
					tooltip, where being absent costs the list nothing.
				-->
				<FontString parentKey="Name" inherits="GameFontNormal" maxLines="1" justifyH="LEFT">
					<Size x="230" y="0"/>
					<Anchors>
						<Anchor point="LEFT" x="10" y="7"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="FrameHighlight" atlas="ClickCastList-ButtonHighlight" setAllPoints="true" alphaMode="ADD"/>
			</Layer>
		</Layers>
		<Frames>
			<!--
				**Declaration order is anchor order.** `relativeKey` is resolved when the frame is
				built, so a key declared later is nil and the anchor is dropped without a word - a
				control that simply never appears. This row is where that happened twice, and
				`npm run check:xml-anchors` exists because of it.

				Right to left and top to bottom, each declared before whatever leans on it. **The two
				lines do different jobs**: getting rid of the entry is up top, and the one thing this
				row is for is along the bottom with the size of what it would do.

				A pin stood beside the delete button, to keep an entry out of the expiry sweep.
				**There is no sweep** - nothing removes an entry but that button - so it exempted the
				reader from something that does not happen, and the line beside it promised a
				clear-out the drawer does not perform. Both are gone until there is one, and it will
				have to ask rather than sweep (`devdocs/building-export-import.md`).
			-->
			<!--
				**The same margin the text keeps on the other side.** `RedButton-Exit` fills its 24px
				square with no transparent border of its own, so the offset here is the whole of the
				gap - at the -2 it inherited from the three-line layout it sat all but flush against
				the row's edge while the left side kept 10.
			-->
			<Button parentKey="DeleteButton" inherits="UIPanelCloseButtonNoScripts">
				<Size x="24" y="24"/>
				<Anchors>
					<Anchor point="RIGHT" x="-10" y="0"/>
				</Anchors>
			</Button>
		</Frames>
		<Layers>
			<Layer level="ARTWORK">
				<!--
					How much is in it, on the line under the title. **The pair sits the way the bin
					list's two-line card sits** (`DebindLineTemplate`): both lines hang off `LEFT`
					at +7 and -8 rather than stacking down from the top, so they stay centred as a
					block instead of leaving the slack at the bottom.
				-->
				<FontString parentKey="Counts" inherits="GameFontHighlightSmall" maxLines="1" justifyH="LEFT">
					<Size x="230" y="0"/>
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Name" relativePoint="LEFT" x="0" y="-15"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<Button name="DebindStoragePreviewRowTemplate" mixin="DebindStoragePreviewRowMixin" virtual="true">
		<Size x="400" y="28"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" atlas="ClickCastList-ButtonBackground">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
				<!--
					The key boundary. Groups are drawn as a **line**, not a header row - the same
					choice the main list made, and for the same reason: a header would promise
					that what follows fires in the order shown, and this window shows one layer
					at a time so it has no standing to say that.
				-->
				<Texture parentKey="GroupBorder" atlas="Options_HorizontalDivider" hidden="true">
					<Size y="1"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<!-- Level with the header's checkbox, which starts at the same inset. -->
				<Texture parentKey="Icon">
					<Size x="20" y="20"/>
					<Anchors>
						<Anchor point="LEFT" x="5" y="0"/>
					</Anchors>
				</Texture>
				<!--
					The key sits on every row even though a group shares one. Reading down a
					column is how you find the key you meant to send; making only the first row
					of a group carry it means the answer moves when the sort changes.

					**Declared before the name, because the name hangs off it.** A `relativeKey`
					pointing at a sibling that does not exist yet does not take, and a FontString
					that ends up with one of its two horizontal points missing has no width and
					draws nothing at all.
				-->
				<FontString parentKey="Key" inherits="GameFontDisableSmall" maxLines="1" justifyH="RIGHT">
					<Size x="120" y="0"/>
					<Anchors>
						<Anchor point="RIGHT" x="-6" y="0"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Name" inherits="GameFontNormal" maxLines="1" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="7" y="0"/>
						<Anchor point="RIGHT" relativeKey="$parent.Key" relativePoint="LEFT" x="-6" y="0"/>
					</Anchors>
				</FontString>
			</Layer>
			<!--
				**A picked row is lit, not ticked.** Same art and same layer the main window uses on
				its selected rows, so "this one is picked" looks one way across the addon.

				It also settles which rung is which. A checkbox on every row put three columns of
				boxes down the list and the eye could not tell the layer's box from an action's; a
				lit row cannot be mistaken for the header above it.
			-->
			<Layer level="OVERLAY">
				<Texture parentKey="SelectedHighlight" atlas="auctionhouse-ui-row-select" alpha=".8" hidden="true" alphaMode="ADD"/>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="FrameHighlight" atlas="ClickCastList-ButtonHighlight" setAllPoints="true" alphaMode="ADD">
					<Color r="1" g="1" b="0" a="1"/>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<!--
		A layer. The window's outer axis, because it is the only grouping actually stored: a key
		group crosses layers and so has nowhere to live (`devdocs/building-export-import.md`).

		Its checkbox is the middle rung of the three: all -> layer -> action.
	-->
	<Button name="DebindStoragePreviewLayerTemplate" inherits="ListHeaderThreeSliceTemplate" mixin="DebindStoragePreviewLayerMixin" virtual="true">
		<Size x="400" y="26"/>
		<Frames>
			<!--
				**This checkbox takes its own clicks**, unlike the one on a row. Here the two
				gestures mean different things - the bar collapses, the box selects - so the box has
				to be able to say "not me" by swallowing the click itself.

				The header text is pushed clear of it in `OnLoad` rather than re-anchored here.
				`ListHeaderThreeSliceMixin` owns that anchor and offers `AdjustTextOffset` for
				exactly this, and writing a second anchor would leave two rules for one position.
			-->
			<CheckButton parentKey="Check" inherits="MinimalCheckboxArtTemplate">
				<Size x="24" y="24"/>
				<Anchors>
					<Anchor point="LEFT" x="5" y="0"/>
				</Anchors>
			</CheckButton>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnClick method="OnClick"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
		</Scripts>
	</Button>

	<!--
		**The main window's Storage tab.**

		Two columns, the same shape Overview has: what there is on the left, what is picked on the
		right. It was two tabs pointing opposite ways at the same list until the list itself became
		the thing (12절 of `devdocs/building-export-import.md`).

		It is a panel and the frame hosts it, which means three things this file has to get right
		(the same three the export panel needed - `.zzz/main-frame-containers.md`):

		  a child of `DebindFrame` by `parent=` + `parentKey=`, seated where `OverviewPanel` sits so
		  `PANELS` can name it by key. It stood parented to `UIParent` and was reparented on the
		  first press only while this file belonged to the load-on-demand addon and so did not exist
		  when `DebindUI.xml` was read

		  `useParentLevel`, or a list's own `frameLevel` would land underneath this panel and
		  draw behind its inset

		  **no `enableMouse`**. A panel covering the whole frame that swallows clicks takes the
		  title bar with it, and the window stops being draggable from this one tab

		`preferredWidth` is the width the frame is asked for, and the only size written here: pinned
		to the host on four sides, a `<Size>` of its own would never be the rectangle it ends up
		with. **It is Overview's number**, because this is now Overview's shape - two columns want
		the room two columns want, and a reader crossing between the two tabs should not have the
		window resize under them.
	-->
	<Frame name="DebindStoragePanel" parent="DebindFrame" parentKey="StoragePanel" hidden="true"
		useParentLevel="true" setAllPoints="true" mixin="DebindStoragePanelMixin">
		<KeyValues>
			<KeyValue key="preferredWidth" value="867" type="number"/>
		</KeyValues>
		<Frames>
			<!--
				The entry list's inset. **Overview's rectangle** (`DebindUI.xml`): the tabs of one
				window should not have their lists jump as the reader moves between them.

				**The bottom is 50 rather than Overview's 10.** That band is where the two buttons
				under this column stand, on the frame's own bottom edge - which is where the click
				binding window puts its own (`Blizzard_ClickBindingUI.xml`).

				A fixed width, given by `<Size>` with only the two left corners pinned. The column
				holds two short lines and a delete button and does not get wider on a wider window;
				what should take the extra room is the preview beside it.
			-->
			<Frame parentKey="ScrollBoxBackground" useParentLevel="true" inherits="TooltipBackdropTemplate">
				<Size x="300" y="0"/>
				<KeyValues>
					<KeyValue key="backdropBorderColor" value="DARKGRAY_COLOR" type="global"/>
					<KeyValue key="backdropColor" value="BLACK_FONT_COLOR" type="global"/>
				</KeyValues>
				<Anchors>
					<Anchor point="TOPLEFT" x="4" y="-85"/>
					<Anchor point="BOTTOMLEFT" x="4" y="50"/>
				</Anchors>
			</Frame>

			<Button parentKey="ScrollBox" inherits="WowScrollBoxList" frameLevel="3">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPLEFT" x="5" y="-5"/>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollBoxBackground" relativePoint="BOTTOMRIGHT" x="-5" y="5"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<!--
							An empty list has to say what fills it, and this one is empty on a first
							login by definition.
						-->
						<FontString parentKey="EmptyText" hidden="true" inherits="GameFontDisable" justifyH="CENTER" wordwrap="true">
							<Size x="240" y="0"/>
							<Anchors>
								<Anchor point="TOP" x="0" y="-60"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</Button>
			<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPRIGHT" x="5" y="-5"/>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="BOTTOMRIGHT" x="5" y="5"/>
				</Anchors>
			</EventFrame>

			<!--
				**The two ways a row gets into the list, under the list.** They are the same kind of
				act pointing at the same column, so they stand together rather than one of them
				sitting above the list as the paste button used to.
			-->
			<Button parentKey="CreateButton" inherits="UIPanelButtonTemplate">
				<Size x="146" y="23"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" x="8" y="5"/>
				</Anchors>
			</Button>
			<Button parentKey="ImportButton" inherits="UIPanelButtonTemplate">
				<Size x="146" y="23"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.CreateButton" relativePoint="RIGHT" x="5" y="0"/>
				</Anchors>
			</Button>

			<!--
				**The right column: what the picked entry holds.**

				Its own frame rather than a second list loose in the panel, so the two columns are
				two things on screen and two things in the code. It takes whatever width is left,
				which is the way round it should be: the entry rows are short and fixed and the
				actions are what a reader is actually reading.

				**Declared after the left column, because it hangs off it.** `relativeKey` resolves
				when the frame is built and a key declared later is nil - the anchor is then dropped
				without a word and the column simply never appears (`check:xml-anchors`).
			-->
			<Frame parentKey="Preview" useParentLevel="true">
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPRIGHT" x="27" y="0"/>
					<Anchor point="BOTTOMRIGHT" x="-31" y="50"/>
				</Anchors>
				<Frames>
					<Frame parentKey="ScrollBoxBackground" useParentLevel="true" inherits="TooltipBackdropTemplate" setAllPoints="true">
						<KeyValues>
							<KeyValue key="backdropBorderColor" value="DARKGRAY_COLOR" type="global"/>
							<KeyValue key="backdropColor" value="BLACK_FONT_COLOR" type="global"/>
						</KeyValues>
					</Frame>

					<Button parentKey="ScrollBox" inherits="WowScrollBoxList" frameLevel="3">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPLEFT" x="5" y="-5"/>
							<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ScrollBoxBackground" relativePoint="BOTTOMRIGHT" x="-5" y="5"/>
						</Anchors>
						<Layers>
							<Layer level="ARTWORK">
								<!--
									**Three things it can be saying** and one of them is the ordinary
									resting state: nothing is picked. The column stands empty rather
									than folding away, so the shape of the tab does not change under
									a click (12절, 소유자).
								-->
								<FontString parentKey="EmptyText" hidden="true" inherits="GameFontDisable" justifyH="CENTER" wordwrap="true">
									<Size x="380" y="0"/>
									<Anchors>
										<Anchor point="TOP" x="0" y="-60"/>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
					</Button>
					<EventFrame parentKey="ScrollBar" inherits="MinimalScrollBar">
						<Anchors>
							<Anchor point="TOPLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPRIGHT" x="5" y="-5"/>
							<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="BOTTOMRIGHT" x="5" y="5"/>
						</Anchors>
					</EventFrame>

					<!--
						The top rung of the three. Above the list because that is where a heading
						over a list goes, and hidden when there is no list under it to head.
					-->
					<CheckButton parentKey="SelectAllCheck" inherits="MinimalCheckboxArtTemplate">
						<Size x="24" y="24"/>
						<Anchors>
							<Anchor point="BOTTOMLEFT" relativeKey="$parent.ScrollBoxBackground" relativePoint="TOPLEFT" x="0" y="4"/>
						</Anchors>
						<Layers>
							<Layer level="ARTWORK">
								<FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT">
									<Anchors>
										<Anchor point="LEFT" relativePoint="RIGHT" x="4" y="0"/>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
					</CheckButton>
				</Frames>
			</Frame>

			<!--
				**The two ways the picked entry leaves, under the column that shows it.** Each pair
				of buttons sits under the column it acts on, so which of the two lists a press is
				about is a matter of where it is rather than something to read.
			-->
			<Button parentKey="CopyButton" inherits="UIPanelButtonTemplate">
				<Size x="160" y="23"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-6" y="5"/>
				</Anchors>
			</Button>
			<Button parentKey="AddButton" inherits="UIPanelButtonTemplate">
				<Size x="120" y="23"/>
				<Anchors>
					<Anchor point="RIGHT" relativeKey="$parent.CopyButton" relativePoint="LEFT" x="-5" y="0"/>
				</Anchors>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
			<OnHide method="OnHide"/>
		</Scripts>
	</Frame>

	<!--
		Where a string is pasted in.

		A dialog rather than a box in the panel, for the reason the copy dialog is one: a box used
		when a string arrives and empty the rest of the time spends the list's height on nothing.
		The drawer is what the panel is for; pasting is how a row gets into it.

		**The shape is the game's own import dialog** - `Blizzard_ClassTalentLoadoutImportDialog.xml`,
		the one a talent loadout is pasted into. It is the same dialog doing the same job, down to the
		second field being a label **the receiving player types**: theirs names the loadout, ours says
		where it came from. What is taken from it:

		  the chrome itself, which is now `DebindDialogTemplate` and shared with the other two
		    dialogs rather than written out here
		  a caption over the big box, `GameFontNormal`, rather than a box with nothing said about it
		  the instruction **inside** the box as placeholder text, so it costs no height once typing starts
		  the second field running the full width, not a short box under a wide one
		  accept and cancel as a centred pair straddling `ContentArea`'s bottom (`120x22`, +-5)

		**With no X, the buttons are the only way out but one.** ESC still closes it
		(`UISpecialFrames`), which is the game's dialog too. It stays draggable from anywhere on
		itself, since there is no bar left to drag it by.

		Their two control frames are not copied, only the geometry they produce: a container apiece
		to hold a label is structure bought for nothing when the label can hang off what it captions.
	-->
	<Frame name="DebindPasteFrame" inherits="DebindDialogTemplate" mixin="DebindPasteFrameMixin">
		<Size x="460" y="315"/>
		<Frames>
			<!--
				100 tall is the game's number for the same box. The placeholder inside it is set from
				Lua (`InputScrollFrame_SetInstructions`) and not by the `instructions` KeyValue the
				template documents: that one names a **global**, and our strings live in `L`.
			-->
			<ScrollFrame parentKey="Input" inherits="InputScrollFrameTemplate">
				<KeyValues>
					<KeyValue key="hideCharCount" value="true" type="boolean"/>
				</KeyValues>
				<Size y="100"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ContentArea" relativePoint="TOPLEFT" x="0" y="-24"/>
					<Anchor point="TOPRIGHT" relativeKey="$parent.ContentArea" relativePoint="TOPRIGHT" x="0" y="-24"/>
				</Anchors>
			</ScrollFrame>

			<!--
				What to call it. Optional, and the only thing about an entry a person writes.

				**It asked who the string came from**, which presumed a sender the game has no way
				to be: a string is copied off a website or out of your own notes, and the reader
				bringing back their own backup had nothing to answer. The client asks the same
				question beside its own paste box and asks it as a name
				().

				**Full width, under a full-width box.** A short box below a wide one reads as a
				lesser field, and this one is not lesser - it is the only thing the reader can say
				about what they just pasted.
			-->
			<EditBox parentKey="NameBox" inherits="InputBoxTemplate" autoFocus="false" letters="40">
				<Size y="22"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.Input" relativePoint="BOTTOMLEFT" x="6" y="-42"/>
					<Anchor point="TOPRIGHT" relativeKey="$parent.Input" relativePoint="BOTTOMRIGHT" x="-6" y="-42"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Label" inherits="GameFontNormal" justifyH="LEFT">
							<Anchors>
								<Anchor point="BOTTOMLEFT" relativePoint="TOPLEFT" x="-6" y="4"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
			</EditBox>

			<!--
				The pair straddles the centre, 5 either side, which is where the game puts the two
				buttons of this dialog. Cancel takes the client's own `CANCEL`, so it is already in
				every language and follows the game if the game ever rewords it.
			-->
			<Button parentKey="CancelButton" inherits="UIPanelButtonTemplate" text="CANCEL">
				<Size x="120" y="22"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.ContentArea" relativePoint="BOTTOM" x="5" y="0"/>
				</Anchors>
			</Button>

			<Button parentKey="AcceptButton" inherits="UIPanelButtonTemplate">
				<Size x="120" y="22"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ContentArea" relativePoint="BOTTOM" x="-5" y="0"/>
				</Anchors>
			</Button>

			<!--
				Why the string was turned down, when it is. It sits above the buttons, so the answer
				is next to the question, and the text stays in the box behind it: a refusal the
				reader cannot act on is a refusal in the wrong place.

				**Declared after those buttons**, because it spans them. The other way round the
				anchors are dropped silently and the refusal never appears, which is the worst place
				for this particular failure, since the whole point of the line is that a rejected
				paste says why.

				**Accept stands on the left and Cancel on the right**, which is the order the game's
				dialog uses and the opposite of the order they are declared in. Reach for the near
				name and the two edges cross: hung off Cancel's left and Accept's right, this frame
				came out 70 wide instead of 330, and every refusal broke into a red column a word
				at a time.
			-->
			<Frame parentKey="ErrorHolder" useParentLevel="true">
				<Anchors>
					<Anchor point="BOTTOMLEFT" relativeKey="$parent.AcceptButton" relativePoint="TOPLEFT" x="-40" y="6"/>
					<Anchor point="BOTTOMRIGHT" relativeKey="$parent.CancelButton" relativePoint="TOPRIGHT" x="40" y="6"/>
				</Anchors>
				<Size y="20"/>
				<Layers>
					<Layer level="ARTWORK">
						<FontString parentKey="Text" inherits="GameFontRedSmall" justifyH="CENTER" wordwrap="true" setAllPoints="true"/>
					</Layer>
				</Layers>
			</Frame>
		</Frames>
		<!--
			**After `<Frames>`, not before them.** This leans on `Input`, and a layer read up top is
			read before the frames are built - the anchor would be dropped without a word and the
			caption would sit wherever the frame's own origin is. The row template above carries the
			same note for the same reason, and moving this to the top is what broke the paste box:
			the caption came loose, `Input` hung off it, and the box the game measures ended up with
			no rectangle to measure.
		-->
		<Layers>
			<Layer level="ARTWORK">
				<FontString parentKey="InputLabel" inherits="GameFontNormal" justifyH="LEFT">
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativeKey="$parent.Input" relativePoint="TOPLEFT" x="0" y="10"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Input" relativePoint="TOPRIGHT" x="0" y="10"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnShow method="OnShow"/>
		</Scripts>
	</Frame>

	<!--
		Where the finished string is handed over.

		**A dialog rather than a box in the window.** The string is read once, selected, copied and
		never looked at again, so a permanent panel spends height on something that is empty almost
		all of the time - and that height is exactly what the list was short of.

		**Same chrome as the other dialogs** - `DebindDialogTemplate`, which took its shape from the
		game's own import dialog (`Blizzard_ClassTalentLoadoutImportDialog.xml`). This and the paste
		dialog are the same gesture in opposite directions and a reader meets them a minute apart,
		which is why none of the geometry is written out here any more.

		**No caption over the box, unlike over there.** That dialog has two boxes and has to say
		which is which; this one has a single box the title already names, and a caption repeating
		the title is a line that says nothing.

		**The close button is not decoration here.** With the X gone, it and ESC are the only ways
		out - and this is the one dialog that is deliberately left standing when its tab goes away.
	-->
	<Frame name="DebindCopyFrame" inherits="DebindDialogTemplate" mixin="DebindCopyFrameMixin">
		<Size x="460" y="185"/>
		<Frames>

			<ScrollFrame parentKey="Output" inherits="InputScrollFrameTemplate">
				<KeyValues>
					<!-- Nobody types here; a character counter over a generated string is noise. -->
					<KeyValue key="hideCharCount" value="true" type="boolean"/>
				</KeyValues>
				<Size y="80"/>
				<Anchors>
					<Anchor point="TOPLEFT" relativeKey="$parent.ContentArea" relativePoint="TOPLEFT"/>
					<Anchor point="TOPRIGHT" relativeKey="$parent.ContentArea" relativePoint="TOPRIGHT"/>
				</Anchors>
			</ScrollFrame>

			<!--
				Centred rather than paired, because there is only one thing to do here: the copy is
				Ctrl-C and this button is just the way back out. `CLOSE` is the client's own, so it
				is already in every language.
			-->
			<Button parentKey="CloseDialogButton" inherits="UIPanelButtonTemplate" text="CLOSE">
				<Size x="120" y="22"/>
				<Anchors>
					<Anchor point="BOTTOM" relativeKey="$parent.ContentArea" relativePoint="BOTTOM" x="0" y="0"/>
				</Anchors>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>


</Ui>
